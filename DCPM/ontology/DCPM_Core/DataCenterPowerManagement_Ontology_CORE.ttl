# ========================================
# DOCUMENT METADATA PROPERTIES
# ========================================

dcpm:documentUrl a owl:DatatypeProperty ;
    rdfs:subPropertyOf dcpm:url ;
    rdfs:label "Document URL" ;
    rdfs:domain dcpm:Document ;
    rdfs:range xsd:anyURI .

dcpm:documentFileName a owl:DatatypeProperty ;
    rdfs:label "Document File Name" ;
    rdfs:domain dcpm:Document ;
    rdfs:range xsd:string .

dcpm:documentVersion a owl:DatatypeProperty ;
    rdfs:label "Document Version" ;
    rdfs:domain dcpm:Document ;
    rdfs:range xsd:string .


# ========================================
# SHACL SHAPES
# ========================================

# 1. Common Device Shape (dcpm:PowerDeviceType)

dcpm:PowerDeviceCommonShape a sh:NodeShape ;
    sh:targetClass dcpm:PowerDeviceType ;
    sh:name "Power Device Common Shape" ;
    # Mandatory Properties
    sh:property [
        sh:path dcpm:manufacturer ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "Manufacturer" ;
        sh:description "Manufacturer of the power device is mandatory."
    ] ;
    sh:property [
        sh:path dcpm:model ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "Model" ;
        sh:description "Model name is mandatory."
    ] ;
    sh:property [
        sh:path dcpm:serialNumber ;
        sh:datatype xsd:string ;
        sh:name "Serial Number" ;
        sh:description "Serial number assigned by the manufacturer (Optional)."
    ] ;
    sh:property [
        sh:path dcpm:assetId ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "Asset ID" ;
        sh:description "Unique internal asset identifier is mandatory."
    ] ;
    # Optional Properties
    sh:property [
        sh:path dcpm:hasSOP ;
        sh:class dcpm:SOP ;
        sh:name "SOP" ;
        sh:description "Standard Operating Procedure documentation (Optional)."
    ] ;
    sh:property [
        sh:path dcpm:hasDocument ;
        sh:class dcpm:Document ;
        sh:name "General Document" ;
        sh:description "Associated technical documentation (Optional)."
    ] .

