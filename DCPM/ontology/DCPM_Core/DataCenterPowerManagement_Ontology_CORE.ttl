@prefix dcpm: <https://qcells.com/schema/dcpm#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rec: <https://w3id.org/rec#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix quantityKind:  <http://qudt.org/vocab/quantityKind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix di: <http://opcfoundation.org/UA/DI/> .
@prefix sdo: <https://schema.org/> .

<https://qcells.com/schema/1.0/dcpm> a owl:Ontology ;
    rdfs:label "DCPM Core" ;
    rdfs:comment "Data Center Power Management (DCPM) Core Ontology version 1.0" ;
    owl:imports <http://opcfoundation.org/UA/DI/> ,
                <http://data.ashrae.org/standard223> ,
                <https://brickschema.org/schema/Brick> ,
                <http://qudt.org/3.1.0/vocab/quantitykind>,
                <http://qudt.org/3.1.0/vocab/unit> ;
    owl:versionIRI <https://qcells.com/schema/1.0/dcpm> ;
    owl:versionInfo "1.0" .

# ===========================
# System Properties 
# ===========================
dcpm:SiteType a owl:Class ;
  rdfs:label "Site" ;
  rdfs:subClassOf rec:Site ;
  rdfs:subClassOf s223:PhysicalSpace ;
  rdfs:comment "The top-level container for a single physical site or data center." .

dcpm:ElectricalRoom a owl:Class ;
  rdfs:label "Electrical Room" ;
  rdfs:subClassOf rec:Room ;
  rdfs:subClassOf s223:PhysicalSpace ;
  owl:equivalentClass brick:Electrical_Room .

dcpm:DataHall a owl:Class ;
  rdfs:label "Data Hall" ;
  rdfs:subClassOf rec:Room ;
  rdfs:subClassOf s223:PhysicalSpace .

dcpm:BatteryRoom a owl:Class ;
  rdfs:label "Battery Room" ;
  rdfs:subClassOf rec:Room ;
  rdfs:subClassOf s223:PhysicalSpace ;
  owl:equivalentClass brick:Battery_Room .

dcpm:GeneratorYard a owl:Class ;
  rdfs:label "Generator Yard" ;
  rdfs:subClassOf rec:OutdoorSpace ;
  rdfs:subClassOf s223:PhysicalSpace ;
  rdfs:subClassOf brick:Outdoor_Area .

dcpm:GeneratorRoom a owl:Class ;
  rdfs:label "Generator Room" ;
  rdfs:subClassOf rec:Room ;
  rdfs:subClassOf s223:PhysicalSpace ;
  rdfs:subClassOf brick:Electrical_Room .

# ===================================
# Device Information Type Models
# ===================================
dcpm:DeviceType a owl:Class ;
  rdfs:label "Device Type" ;
  owl:equivalentClass di:DeviceType ;
  rdfs:subClassOf brick:Equipment, s223:Equipment ;
  rdfs:comment "A general class representing types of devices in the data center, used for modeling static information and specifications." .

dcpm:PowerDeviceType a owl:Class ;
  rdfs:label "PowerDevice" ;
  rdfs:subClassOf dcpm:DeviceType ;
  rdfs:comment "A class representing types of power-related devices in the data center, such as switchgear, transformers, UPS, etc." .

dcpm:SwitchgearType a owl:Class ;
  owl:equivalentClass brick:Switchgear ;
  rdfs:label "Switchgear" ;
  rdfs:comment "Represents the main switchgear that receives power from the utility and distributes it to the site." ;
  rdfs:subClassOf dcpm:PowerDeviceType .

dcpm:FeederType a owl:Class ;
  rdfs:label "Feeder" ;
  rdfs:comment "Represents an individual feeder circuit within a switchgear or panelboard." ;
  rdfs:subClassOf dcpm:PowerDeviceType .

dcpm:TransformerType a owl:Class ;
  rdfs:subClassOf s223:ElectricEnergyTransformer ;
  owl:equivalentClass brick:Transformer ;
  rdfs:label "Transformer" ;
  rdfs:comment "Represents a power transformer." ;
  rdfs:subClassOf dcpm:PowerDeviceType .

dcpm:ATSType a owl:Class ;
  owl:equivalentClass brick:Automatic_Transfer_Switch ;
  rdfs:label "Automatic Transfer Switch" ;
  rdfs:comment "Represents an Automatic Transfer Switch." ;
  rdfs:subClassOf dcpm:PowerDeviceType .

dcpm:UPSType a owl:Class ;
  owl:equivalentClass brick:Uninterruptible_Power_Supply ;
  rdfs:label "Uninterruptible Power Supply" ;
  rdfs:comment "Represents an Uninterruptible Power Supply." ;
  rdfs:subClassOf dcpm:PowerDeviceType .

dcpm:BESSType a owl:Class ;
  owl:equivalentClass brick:Battery_Energy_Storage_System ;
  rdfs:label "Battery Energy Storage System" ;
  rdfs:comment "Represents a Battery Energy Storage System, including the Power Conversion System (PCS)." ;
  rdfs:subClassOf dcpm:PowerDeviceType .

dcpm:BMSType a owl:Class ;
  rdfs:subClassOf brick:Electrical_Equipment ;
  rdfs:label "Battery Management System" ;
  rdfs:comment "Represents a standalone Battery Management System." ;
  rdfs:subClassOf dcpm:PowerDeviceType .

dcpm:GeneratorSetType a owl:Class ;
  owl:equivalentClass s223:Generator ;
  owl:equivalentClass brick:Generator ;
  rdfs:label "Diesel/Gas Generator" ;
  rdfs:comment "Represents a generator set." ;
  rdfs:subClassOf dcpm:PowerDeviceType .

dcpm:PDUType a owl:Class ;
  rdfs:subClassOf brick:Electrical_Equipment ;
  rdfs:label "Power Distribution Unit" ;
  rdfs:comment "Represents a floor-level or mains Power Distribution Unit." ;
  rdfs:subClassOf dcpm:PowerDeviceType .

dcpm:RPPType a owl:Class ;
  rdfs:subClassOf brick:Electrical_Equipment ;
  rdfs:label "Remote Power Panel" ;
  rdfs:comment "Represents a Remote Power Panel, similar to a PDU but typically smaller and closer to the load." ;
  rdfs:subClassOf dcpm:PDUType .

dcpm:BuswayType a owl:Class ;
  rdfs:subClassOf brick:Electrical_Equipment ;
  rdfs:label "Busway and Bus Duct" ;
  rdfs:comment "Represents a busway power distribution system." ;
  rdfs:subClassOf dcpm:PowerDeviceType .

dcpm:RackPDUType a owl:Class ;
  rdfs:subClassOf brick:Electrical_Equipment ;
  rdfs:label "Rack Power Distribution Unit" ;
  rdfs:comment "Represents a rack-mounted PDU with outlet-level monitoring and control." ;
  rdfs:subClassOf dcpm:PDUType .

dcpm:STSType a owl:Class ;
  owl:equivalentClass brick:Static_Transfer_Switch ;
  rdfs:label "Static Transfer Switch" ;
  rdfs:comment "Represents a Static Transfer Switch." ;
  rdfs:subClassOf dcpm:ATSType .

dcpm:PQMeterType a owl:Class ;
  rdfs:subClassOf brick:Meter ;
  rdfs:label "Power Quality Meter" ;
  rdfs:comment "Represents a dedicated power quality monitoring device." ;
  rdfs:subClassOf dcpm:PowerDeviceType .

dcpm:GatewayType a owl:Class ;
  owl:equivalentClass brick:Gateway ;
  rdfs:label "Gateway / SCADA" ;
  rdfs:comment "Represents a Gateway or SCADA." ;
  rdfs:subClassOf dcpm:PowerDeviceType .

dcpm:ControllerType a owl:Class ;
  owl:equivalentClass s223:Controller ;
  owl:equivalentClass brick:Controller ;
  rdfs:label "PLC Controls" ;
  rdfs:comment "Represents a site controller or PLC." ;
  rdfs:subClassOf dcpm:PowerDeviceType .

dcpm:MCCType a owl:Class ;
  owl:equivalentClass brick:Motor_Control_Center ;
  rdfs:label "Motor Control Center" ;
  rdfs:comment "Represents a Motor Control Center." ;
  rdfs:subClassOf dcpm:PowerDeviceType .

dcpm:MotorFeederType a owl:Class ;
  rdfs:subClassOf brick:Electrical_Equipment ;
  rdfs:label "Motor Feeder" ;
  rdfs:comment "Represents an individual motor starter/feeder within an MCC." ;
  rdfs:subClassOf dcpm:PowerDeviceType .

dcpm:SPDType a owl:Class ;
  rdfs:subClassOf brick:Electrical_Equipment ;
  rdfs:label "Surge Protective Device" ;
  rdfs:comment "Represents a Surge Protective Device." ;
  rdfs:subClassOf dcpm:PowerDeviceType .

dcpm:GroundingNetworkType a owl:Class ;
  rdfs:subClassOf brick:Electrical_Equipment ;
  rdfs:label "Grounding & Bonding Network" ;
  rdfs:comment "Represents the monitoring points of the facility grounding system." ;
  rdfs:subClassOf dcpm:PowerDeviceType .

dcpm:UtilityMeterType a owl:Class ;
  rdfs:subClassOf s223:ElectricityMeter ;
  rdfs:subClassOf brick:Electrical_Meter ;
  rdfs:label "Utility Meter" ;
  rdfs:subClassOf dcpm:PowerDeviceType .

dcpm:ITRackType a owl:Class ;
  rdfs:subClassOf brick:ICT_Equipment ;
  rdfs:subClassOf dcpm:PowerDeviceType ;
  rdfs:label "IT Rack" .

# ========================================
# Common Structures and classes
# ========================================

dcpm:BatteryMetricsType a owl:Class ;
  rdfs:label "Battery Metrics Type" .

dcpm:BatteryStringMetricsType a owl:Class ;
  rdfs:label "Battery String Metrics Type" .

dcpm:CellMetricsType a owl:Class ;
  rdfs:label "Cell Metrics Type" .

dcpm:ElectricalMeasurementsType a owl:Class ;
  rdfs:label "Electrical Measurements Type" .

dcpm:TelemetryStream a owl:Class ;
  rdfs:label "Telemetry Stream" ;
  rdfs:comment "A logical grouping of related telemetry points for a given device (e.g., Input, Output, Battery)" .

dcpm:TelemetryPoint a owl:Class ;
    rdfs:label "Telemetry Point" ;
    rdfs:comment "Represents a single measured data point such as voltage, current, frequency, etc." .

dcpm:SOP a owl:Class ;
  rdfs:label "SOP" ;
  rdfs:comment "Standard Operating Procedures (SOPs) for critical equipment." .

dcpm:MOP a owl:Class ;
  rdfs:label "MOP" ;
  rdfs:comment "Method of Procedure (MOPs) for equipment maintenance tasks." .

dcpm:Document a owl:Class ;
  rdfs:label "Document" ;
  rdfs:comment "Represents any internal or external documentation associated with a device." .

dcpm:KPI a owl:Class ;
  rdfs:label "KPI" ;
  rdfs:comment "Key Performance Indicator (KPI) for monitoring device or system performance." .

dcpm:PointOfInterconnection a owl:Class ;
rdfs:label "Point of Interconnection (POI)" ;
rdfs:comment "Electrical (or other) point of interconnection with the grid or utility—e.g. meter point for settlement, demand, or value stream participation. Optimization may treat POI as the boundary for demand, export, or program eligibility." .

dcpm:ValueStream a owl:Class ;
rdfs:label "Value Stream" ;
rdfs:comment "An entity representing a revenue or cost optimization pathway (e.g., demand response, energy arbitrage, bill reduction). A value stream MAY be associated with a Point of Interconnection entity, a Site entity, and/or an Equipment entity—depending on where the program is defined or measured (e.g. at the meter, site, or specific asset)." .

# ========================================
# Static Properties for System
# ========================================
dcpm:url a owl:DatatypeProperty ;
    rdfs:range xsd:anyURI ;
    rdfs:label "URL" ;
    rdfs:subPropertyOf sdo:url ;
    rdfs:comment "URL link to the any type of content." .

dcpm:preferredName a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Preferred Name" ;
    rdfs:subPropertyOf skos:prefLabel ;
    rdfs:comment "Preferred name of the entity, which may differ from the label used." .

dcpm:legalEntityName a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Legal Entity Name" ;
    rdfs:subPropertyOf sdo:legalName ;
    rdfs:comment "Legal entity name of the organization that owns or operates the data center." .

dcpm:timeZone a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Time Zone" ;
    rdfs:comment "Time zone of the location, typically in IANA format (e.g., 'America/New_York')." .

dcpm:primaryBusinessSegment a owl:DatatypeProperty ;
    rdfs:range dcpm:BusinessSegmentEnum ;
    rdfs:label "Primary Business Segment" ;
    rdfs:comment "Primary business segment of the data center (e.g., Hyperscale, Colocation, Enterprise, Edge)." .

# ========================================
# Static Properties for PowerDeviceType 
# ========================================
dcpm:manufacturer a owl:DatatypeProperty ;
    owl:equivalentProperty di:Manufacturer ;
    rdfs:range xsd:string ;
    rdfs:label "Manufacturer" ;
    rdfs:comment "Manufacturer name of the power device (aligned with OPC UA DI:Manufacturer)." .

dcpm:model a owl:DatatypeProperty ;
    owl:equivalentProperty di:Model ;
    rdfs:range xsd:string ;
    rdfs:label "Model Name" ;
    rdfs:comment "Device model name or identifier (aligned with OPC UA DI:Model)." .

dcpm:serialNumber a owl:DatatypeProperty ;
    owl:equivalentProperty di:SerialNumber ;
    rdfs:range xsd:string ;
    rdfs:label "Serial Number" ;
    rdfs:comment "Unique serial number assigned by the manufacturer (aligned with OPC UA DI:SerialNumber)." .

dcpm:softwareRevision a owl:DatatypeProperty ;
    owl:equivalentProperty di:SoftwareRevision ;
    rdfs:range xsd:string ;
    rdfs:label "Software Revision" ;
    rdfs:comment "Software or controller revision of the device (aligned with OPC UA DI:SoftwareRevision)." .

dcpm:firmwareVersion a owl:DatatypeProperty ;
    rdfs:subPropertyOf di:SoftwareRevision ;
    rdfs:range xsd:string ;
    rdfs:label "Firmware Version" ;
    rdfs:comment "Firmware version currently running on the device (specialization of OPC UA DI:SoftwareRevision)." .

dcpm:ipAddress a owl:DatatypeProperty ;
    rdfs:subPropertyOf di:NetworkAddress ;
    rdfs:range xsd:string ;
    rdfs:label "IP Address" ;
    rdfs:comment "IPv4 or IPv6 address assigned to the device (subproperty of DI:NetworkAddress)." .

dcpm:communicationProtocol a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Communication Protocol" ;
    rdfs:comment "Communication protocol supported by the device (e.g., Modbus TCP, SNMP, BACnet)." .

dcpm:batteryType a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Battery Type" ;
    rdfs:comment "Type of battery used by the device (e.g., VRLA, Li-ion, NiCd)." .

dcpm:batteryStringCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "Battery String Count" ;
    rdfs:comment "Number of battery strings or blocks configured in the system." .

dcpm:numberOfPoles a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "Number of Poles" ;
    rdfs:comment "Number of poles in the Automatic Transfer Switch." .

dcpm:transferType a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Transfer Type" ;
    rdfs:comment "Transfer type of the ATS (e.g., Open Transition, Closed Transition)." .

dcpm:busbarRating a owl:DatatypeProperty ;
    rdfs:range xsd:float ;
    rdfs:label "Busbar Rating (A)" ;
    rdfs:comment "Busbar current rating of the switchgear in amperes." .

dcpm:breakerType a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Breaker Type" ;
    rdfs:comment "Type of circuit breaker used (e.g., Emax 2, Plug-in)." .

dcpm:breakerCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "Breaker Count" ;
    rdfs:comment "Number of circuit breakers installed in the switchgear." .

dcpm:impedancePercent a owl:DatatypeProperty ;
    rdfs:range xsd:float ;
    rdfs:label "Impedance (%)" ;
    rdfs:comment "Transformer impedance expressed as percentage." .

dcpm:coolingType a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Cooling Type" ;
    rdfs:comment "Cooling method of the PowerDeviceType." .

dcpm:temperatureSensorInstalled a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "Temperature Sensor Installed" ;
    rdfs:comment "Indicates whether a temperature sensor is installed in the PowerDeviceType." .

dcpm:transferTimeMS a owl:DatatypeProperty ;
    rdfs:range xsd:float ;
    rdfs:label "Transfer Time (ms)" ;
    rdfs:comment "Transfer time of switch during source change, in milliseconds." .

dcpm:preferredSource a owl:DatatypeProperty ;
    rdfs:range dcpm:SourceEnum ;
    rdfs:label "Preferred Source" ;
    rdfs:comment "Preferred input source for the device, defined by SourceEnum (e.g., Utility, Generator, UPS)." .

dcpm:selectedSource a owl:DatatypeProperty ;
    rdfs:range dcpm:SourceEnum ;
    rdfs:label "Selected Source" ;
    rdfs:comment "Currently selected input source for the device, defined by SourceEnum (e.g., Utility, Generator, UPS)." .

dcpm:circuitCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "Circuit Count" ;
    rdfs:comment "Number of electrical circuits managed by the PDU or RPP." .

dcpm:buswayConnection a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "Busway Connection" ;
    rdfs:comment "Indicates whether the PDU is connected to a busway system." .

dcpm:outletCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "Outlet Count" ;
    rdfs:comment "Number of output outlets on the rack PDU." .

dcpm:fuelType a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Fuel Type" ;
    rdfs:comment "Type of fuel used by the generator (e.g., Diesel, Natural Gas, Propane)." .

dcpm:fuelTankCapacity a owl:DatatypeProperty ;
  rdfs:range xsd:float ;
  rdfs:label "Fuel Tank Capacity (L or gal)" ;
  rdfs:comment "Fuel tank capacity of the generator, in liters or gallons." .

dcpm:hasValue a owl:DatatypeProperty ;
  rdfs:label "Has Value" ;
  rdfs:comment "Represents the numeric value associated with a measurement." .

dcpm:formula a owl:DatatypeProperty ;
  rdfs:label "Formula" ;
  rdfs:comment "Represents the formula or calculation method used to derive a measurement or KPIs." .

dcpm:calculationRate a owl:DatatypeProperty ;
  rdfs:label "Calculation Rate" ;
  rdfs:comment "Represents the rate at which a measurement or KPI is calculated or updated." .

dcpm:pointName a owl:DatatypeProperty ;
  rdfs:label "Point Name" ;
  rdfs:range xsd:string ;
  rdfs:comment "String identifier for a telemetry point, typically following a hierarchical naming convention." .

dcpm:importLimitMax a owl:DatatypeProperty ;
    rdfs:range xsd:float ;
    rdfs:label "Import Limit Max (kW or MW)" ;
    rdfs:comment "Maximum power import at the POI (e.g. kW or MW). Used by optimization to respect grid/contractual limits." .

dcpm:exportLimitMax a owl:DatatypeProperty ;
    rdfs:range xsd:float ;
    rdfs:label "Export Limit Max (kW or MW)" ;
    rdfs:comment "Maximum power export at the POI (e.g. kW or MW). Used by optimization to respect grid/contractual limits." .

dcpm:UPSMode a owl:DatatypeProperty ;
    rdfs:range dcpm:UPSModeEnum ;
    rdfs:label "UPS Mode" ;
    rdfs:comment "Current operating mode of the UPS, defined by UPSModeEnum (e.g., Normal, Battery, Bypass)." .

dcpm:GENMode a owl:DatatypeProperty ;
    rdfs:range dcpm:GenModeEnum ;
    rdfs:label "Generator Mode" ;
    rdfs:comment "Current operating mode of the generator, defined by GenModeEnum (e.g., Off, Starting, Running, Stopped)." .

dcpm:maxLoad a owl:DatatypeProperty ;
    rdfs:label "Maximum Load" ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Represents the maximum load capacity of the device." .

# ========================================
# Static Properties for Identifiers
# ========================================
dcpm:siteId a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Site Identifier" ;
    rdfs:comment "A unique identifier for the physical site or data center." .

dcpm:assetId a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Asset Identifier" ;
    rdfs:comment "A unique asset identifier assigned to the device." .

dcpm:locationId a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Location Identifier" ;
    rdfs:comment "A unique location identifier for the physical location." .

dcpm:POIId a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "POI Identifier" ;
    rdfs:comment "A unique identifier for the Point of Interconnection (POI) with the utility or grid." .

dcpm:ValueStreamId a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Value Stream Identifier" ;
    rdfs:comment "A unique identifier for the value stream " .

dcpm:ValueStreamProgram a owl:DatatypeProperty ;
    rdfs:range dcpm:ValueStreamProgramEnum ;
    rdfs:label "Value Stream Program" ;
    rdfs:comment "Name or identifier of the specific program or initiative associated with the value stream (e.g., demand response program name)." .

dcpm:latitude a owl:DatatypeProperty ;
    rdfs:range xsd:float ;
    rdfs:label "Latitude" ;
    rdfs:subPropertyOf brick:latitude ;
    rdfs:comment "Latitude coordinate of the site location." .

dcpm:longitude a owl:DatatypeProperty ;
    rdfs:range xsd:float ;
    rdfs:label "Longitude" ;
    rdfs:subPropertyOf brick:longitude ;
    rdfs:comment "Longitude coordinate of the site location." .

dcpm:tariffReference a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Tariff Reference" ;
    rdfs:comment "Reference to the applicable utility tariff or rate schedule for this Point of Interconnection." .

# ===========================
# Measurement classes
# ===========================
dcpm:ActiveEnergy a owl:Class ;
  rdfs:subClassOf dcpm:TelemetryPoint ;
  rdfs:label "Active Energy (kWh)" ;
  qudt:quantityKind quantityKind:ActiveEnergy ;
  qudt:applicableUnit unit:KiloW-HR,
                      unit:MegaW-HR,
                      unit:W-HR ;
  rdfs:comment "General active energy measurement, can represent import, export, or total energy." .

dcpm:ExportActiveEnergy a owl:Class ;
  rdfs:label "Active Energy Export (kWh)" ;
  rdfs:subClassOf dcpm:ActiveEnergy ;
  qudt:quantityKind quantityKind:ActiveEnergy ;
  qudt:applicableUnit unit:KiloW-HR,
                      unit:MegaW-HR,
                      unit:W-HR .

dcpm:ImportActiveEnergy a owl:Class ;
  rdfs:label "Active Energy Import (kWh)" ;
  rdfs:subClassOf dcpm:ActiveEnergy ;
  qudt:quantityKind quantityKind:ActiveEnergy ;
  qudt:applicableUnit unit:KiloW-HR,
                      unit:MegaW-HR,
                      unit:W-HR .

dcpm:ActivePower a owl:Class ;
rdfs:subClassOf dcpm:TelemetryPoint ;
  rdfs:label "Active Power (kW or MW)" ;
  qudt:quantityKind quantityKind:ActivePower ;
  qudt:applicableUnit unit:KiloW,
                      unit:MegaW,
                      unit:W .

dcpm:ImportActivePower a owl:Class ;
  rdfs:label "Import Active Power (kW or MW)" ;
  rdfs:subClassOf dcpm:ActivePower ;
  qudt:quantityKind quantityKind:ActivePower ;
  qudt:applicableUnit unit:KiloW,
                      unit:MegaW,
                      unit:W ;
  rdfs:comment "Measured active power flowing into the site or device." .

dcpm:ImportActivePowerL1 a owl:Class ;
  rdfs:label "Import Active Power L1 (kW or MW)" ;
  rdfs:subClassOf dcpm:ImportActivePower ;
  qudt:quantityKind quantityKind:ActivePower ;
  qudt:applicableUnit unit:KiloW,
                      unit:MegaW,
                      unit:W ;
  rdfs:comment "Measured active power flowing into the site or device on phase L1." .

dcpm:ImportActivePowerL2 a owl:Class ;
  rdfs:label "Import Active Power L2 (kW or MW)" ;
  rdfs:subClassOf dcpm:ImportActivePower ;
  qudt:quantityKind quantityKind:ActivePower ;
  qudt:applicableUnit unit:KiloW,
                      unit:MegaW,
                      unit:W ;
  rdfs:comment "Measured active power flowing into the site or device on phase L2." .

dcpm:ImportActivePowerL3 a owl:Class ;
  rdfs:label "Import Active Power L3 (kW or MW)" ;
  rdfs:subClassOf dcpm:ImportActivePower ;
  qudt:quantityKind quantityKind:ActivePower ;
  qudt:applicableUnit unit:KiloW,
                      unit:MegaW,
                      unit:W ;
  rdfs:comment "Measured active power flowing into the site or device on phase L3." .

dcpm:ExportActivePower a owl:Class ;
  rdfs:label "Export Active Power (kW or MW)" ;
  rdfs:subClassOf dcpm:ActivePower ;
  qudt:quantityKind quantityKind:ActivePower ;
  qudt:applicableUnit unit:KiloW,
                      unit:MegaW,
                      unit:W ;
  rdfs:comment "Measured active power flowing out of the site or device." .

dcpm:ExportActivePowerL1 a owl:Class ;
  rdfs:label "Export Active Power L1 (kW or MW)" ;
  rdfs:subClassOf dcpm:ExportActivePower ;
  qudt:quantityKind quantityKind:ActivePower ;
  qudt:applicableUnit unit:KiloW,
                      unit:MegaW,
                      unit:W ;
  rdfs:comment "Measured active power flowing out of the site or device on phase L1." .

dcpm:ExportActivePowerL2 a owl:Class ;
  rdfs:label "Export Active Power L2 (kW or MW)" ;
  rdfs:subClassOf dcpm:ExportActivePower ;
  qudt:quantityKind quantityKind:ActivePower ;
  qudt:applicableUnit unit:KiloW,
                      unit:MegaW,
                      unit:W ;
  rdfs:comment "Measured active power flowing out of the site or device on phase L2." .

