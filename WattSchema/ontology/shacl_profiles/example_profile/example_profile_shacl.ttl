                sh:hasValue unit:PERCENT ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Maximum State of Charge" ;
        sh:description "BESS maximum SoC limit"
    ] ;
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:ChargePowerSetpoint ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Charge Power Setpoint" ;
        sh:description "BESS charge power setpoint (kW)"
    ] ;
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:DischargePowerSetpoint ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Discharge Power Setpoint" ;
        sh:description "BESS discharge power setpoint (kW)"
    ] ;
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:ChargeEfficiency ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Charge Efficiency" ;
        sh:description "BESS charge efficiency"
    ] ;
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:DischargeEfficiency ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Discharge Efficiency" ;
        sh:description "BESS discharge efficiency"
    ] ;
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:ActivePower ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Active Power Point" ;
        sh:description "BESS must monitor active power (kW)"
    ] ;
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:Voltage ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
