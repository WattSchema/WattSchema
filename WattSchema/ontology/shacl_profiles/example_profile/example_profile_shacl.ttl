# ========================================
# Grounding Network Shape
# ========================================

dcpm:GroundingNetworkShape a sh:NodeShape ;
    sh:targetClass dcpm:GroundingNetworkType ;
    sh:name "Grounding Network Shape for DCPM Power System" ;
    sh:description "SHACL shape for grounding and bonding network" ;

    sh:property [
        sh:path dcpm:protects ;
        sh:class dcpm:PowerDeviceType ;
        sh:name "protects target" ;
    ] ;
    sh:property [
        sh:path dcpm:hasDocument ;
        sh:class dcpm:Document ;
        sh:name "hasDocument target" ;
    ] .


# ========================================
# Power Quality and Monitoring Shapes
# ========================================

dcpm:PQMeterShape a sh:NodeShape ;
    sh:targetClass dcpm:PQMeterType ;
    sh:name "Power Quality Meter Shape for DCPM Power System" ;
    sh:description "SHACL shape requiring power quality meters to have comprehensive monitoring" ;

    # --- Telemetry  ---
    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class dcpm:THDV ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:PERCENT ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Total Harmonic Distortion Voltage" ;
        sh:description "PQ Meter must measure voltage THD (%)"
    ] ;
    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class dcpm:THDI ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:PERCENT ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Total Harmonic Distortion Current" ;
        sh:description "PQ Meter must measure current THD (%)"
    ] ;

    # --- Relationships ---
    sh:property [
        sh:path dcpm:connectedTo ;
        sh:class dcpm:PowerDeviceType ;
        sh:name "connectedTo target" ;
    ] ;
    sh:property [
        sh:path dcpm:hasLocation ;
        sh:class dcpm:ElectricalRoom ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path dcpm:hasDocument ;
        sh:class dcpm:Document ;
        sh:name "hasDocument target" ;
    ] .


# ========================================
# Control and Monitoring Infrastructure
# ========================================

dcpm:ControllerShape a sh:NodeShape ;
    sh:targetClass dcpm:ControllerType ;
    sh:name "Power System Controller Shape for DCPM" ;
    sh:description "SHACL shape requiring controllers to have monitoring, control, and connection capabilities" ;

    sh:property [
        sh:path dcpm:communicationProtocol ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "Communication Protocol" ;
        sh:description "Controller must support a communication protocol (Modbus TCP, BACnet, OPC UA, etc.)"
    ] ;
    sh:property [
        sh:path dcpm:ipAddress ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "IP Address" ;
        sh:description "Controller must have a network address"
    ] ;
    sh:property [
        sh:path dcpm:controls ;
        sh:class dcpm:PowerDeviceType ;
        sh:name "controls target" ;
    ] ;
    sh:property [
        sh:path dcpm:connectedTo ;
        sh:or (
            [ sh:class dcpm:GatewayType ]
            [ sh:class dcpm:PowerDeviceType ]
        ) ;
        sh:name "connectedTo target" ;
    ] ;
    sh:property [
        sh:path dcpm:hasLocation ;
        sh:class dcpm:ElectricalRoom ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path dcpm:hasDocument ;
        sh:class dcpm:Document ;
        sh:name "hasDocument target" ;
    ] .

dcpm:GatewayShape a sh:NodeShape ;
    sh:targetClass dcpm:GatewayType ;
    sh:name "Gateway/SCADA Shape for DCPM Power System" ;
    sh:description "SHACL shape requiring gateways to have communication and aggregation capabilities" ;

    sh:property [
        sh:path dcpm:communicationProtocol ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "Communication Protocol" ;
        sh:description "Gateway must support communication protocols"
    ] ;
    sh:property [
        sh:path dcpm:ipAddress ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "IP Address" ;
        sh:description "Gateway must have a network address"
    ] ;
    sh:property [
        sh:path dcpm:connectedTo ;
        sh:or (
            [ sh:class dcpm:ControllerType ]
            [ sh:class dcpm:PowerDeviceType ]
        ) ;
        sh:name "connectedTo target" ;
    ] ;
    sh:property [
        sh:path dcpm:hasLocation ;
        sh:class dcpm:ElectricalRoom ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path dcpm:hasDocument ;
        sh:class dcpm:Document ;
        sh:name "hasDocument target" ;
    ] .


# ========================================
# Physical Space Shapes
# ========================================

dcpm:ElectricalRoomShape a sh:NodeShape ;
    sh:targetClass dcpm:ElectricalRoom ;
    sh:name "Electrical Room Shape" ;

    sh:property [
        sh:path dcpm:containsEquipment ;
        sh:or (
            [ sh:class dcpm:SwitchgearType ]
            [ sh:class dcpm:TransformerType ]
            [ sh:class dcpm:UPSType ]
            [ sh:class dcpm:PDUType ]
            [ sh:class dcpm:ATSType ]
            [ sh:class dcpm:ControllerType ]
            [ sh:class dcpm:GatewayType ]
            [ sh:class dcpm:PQMeterType ]
            [ sh:class dcpm:SPDType ]
        ) ;
        sh:name "containsEquipment target" ;
    ] ;
    sh:property [
        sh:path dcpm:isLocationOf ;
        sh:class dcpm:PowerDeviceType ;
        sh:name "isLocationOf target" ;
    ] .

dcpm:DataHallShape a sh:NodeShape ;
    sh:targetClass dcpm:DataHall ;
    sh:name "Data Hall Shape" ;

    sh:property [
        sh:path dcpm:containsEquipment ;
        sh:or (
            [ sh:class dcpm:ITRackType ]
            [ sh:class dcpm:RackPDUType ]
            [ sh:class dcpm:BuswayType ]
            [ sh:class dcpm:PDUType ]
            [ sh:class dcpm:RPPType ]
        ) ;
        sh:name "containsEquipment target" ;
    ] ;
    sh:property [
        sh:path dcpm:isLocationOf ;
        sh:class dcpm:PowerDeviceType ;
        sh:name "isLocationOf target" ;
    ] .

dcpm:BatteryRoomShape a sh:NodeShape ;
    sh:targetClass dcpm:BatteryRoom ;
    sh:name "Battery Room Shape" ;

    sh:property [
        sh:path dcpm:containsEquipment ;
        sh:or (
            [ sh:class dcpm:BESSType ]
            [ sh:class dcpm:BMSType ]
        ) ;
        sh:name "containsEquipment target" ;
    ] ;
    sh:property [
        sh:path dcpm:isLocationOf ;
        sh:class dcpm:PowerDeviceType ;
        sh:name "isLocationOf target" ;
    ] .

dcpm:GeneratorYardShape a sh:NodeShape ;
    sh:targetClass dcpm:GeneratorYard ;
    sh:name "Generator Yard Shape" ;

    sh:property [
        sh:path dcpm:containsEquipment ;
        sh:class dcpm:GeneratorSetType ;
        sh:name "containsEquipment target" ;
    ] .

dcpm:GeneratorRoomShape a sh:NodeShape ;
    sh:targetClass dcpm:GeneratorRoom ;
    sh:name "Generator Room Shape" ;

    sh:property [
        sh:path dcpm:containsEquipment ;
        sh:class dcpm:GeneratorSetType ;
        sh:name "containsEquipment target" ;
    ] .


# ========================================
# Telemetry Shapes
# ========================================

dcpm:TelemetryPointShape a sh:NodeShape ;
    sh:targetClass dcpm:TelemetryPoint ;
    sh:name "Telemetry Point Shape" ;

    sh:property [
        sh:path dcpm:isTelemetryOf ;
        sh:or (
            [ sh:class dcpm:PowerDeviceType ]
            [ sh:class dcpm:TelemetryStream ]
        ) ;
        sh:name "isTelemetryOf target" ;
    ] ;
    sh:property [
        sh:path dcpm:hasPhase ;
        sh:class dcpm:Phase ;
        sh:maxCount 1 ;
        sh:name "hasPhase target" ;
        sh:description "A telemetry point is associated with at most one electrical phase."
    ] .

dcpm:TelemetryStreamShape a sh:NodeShape ;
    sh:targetClass dcpm:TelemetryStream ;
    sh:name "Telemetry Stream Shape" ;

    sh:property [
        sh:path dcpm:isTelemetryStreamOf ;
        sh:class dcpm:PowerDeviceType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "isTelemetryStreamOf target" ;
        sh:description "A telemetry stream belongs to exactly one power device."
    ] ;
    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:class dcpm:TelemetryPoint ;
        sh:name "hasTelemetryPoint target" ;
        sh:description "A stream contains one or more telemetry points."
    ] .
