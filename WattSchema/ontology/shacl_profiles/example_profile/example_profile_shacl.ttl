@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix dcpm: <https://qcells.com/schema/dcpm/#> .
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rec:  <https://w3id.org/rec#> .


# ========================================
# Site Shape
# ========================================

dcpm:SiteShape a sh:NodeShape ;
    sh:targetClass dcpm:SiteType ;
    sh:name "Site Shape for DCPM Power System" ;
    sh:description "SHACL shape requiring each site to have proper power system components" ;

    sh:property [
        sh:path dcpm:latitude ;
        sh:datatype xsd:float ;
        sh:minCount 1 ;
        sh:name "Site Latitude" ;
        sh:description "Site must include latitude in decimal degrees"
    ] ;
    sh:property [
        sh:path dcpm:longitude ;
        sh:datatype xsd:float ;
        sh:minCount 1 ;
        sh:name "Site Longitude" ;
        sh:description "Site must include longitude in decimal degrees"
    ] ;
    sh:property [
        sh:path dcpm:siteId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:name "Site Identifier" ;
        sh:description "Site must have a unique identifier"
    ] ;
    sh:property [
        sh:path dcpm:hasPointOfInterconnection ;
        sh:class dcpm:PointOfInterconnection ;
        sh:name "Point of Interconnection" ;
        sh:description "Site's grid connection point(s)."
    ] ;
    sh:property [
        sh:path dcpm:hasValueStream ;
        sh:class dcpm:ValueStream ;
        sh:name "Value Stream" ;
        sh:description "Revenue or cost optimization pathway associated with the site."
    ] ;
    sh:property [
        sh:path dcpm:containsEquipment ;
        sh:class dcpm:PowerDeviceType ;
        sh:name "Contains Equipment" ;
        sh:description "Power devices physically contained within the site."
    ] ;
    sh:property [
        sh:path dcpm:isLocationOf ;
        sh:class dcpm:PowerDeviceType ;
        sh:name "Is Location Of" ;
        sh:description "Power devices located at this site."
    ] ;
    sh:property [
        sh:path rec:ownedBy ;
        sh:class rec:Organization ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:name "Owned By" ;
        sh:description "Site must be owned by exactly one Organization"
    ] .


# ========================================
# Point of Interconnection Shape
# ========================================

dcpm:POIShape a sh:NodeShape ;
    sh:targetClass dcpm:PointOfInterconnection ;
    sh:name "Point of Interconnection Shape for DCPM Power System" ;
    sh:description "SHACL shape for grid interconnection points" ;

    sh:property [
        sh:path dcpm:feeds ;
        sh:class dcpm:UtilityMeterType ;
        sh:name "feeds target" ;
        sh:description "POI feeds utility meter."
    ] ;
    sh:property [
        sh:path dcpm:suppliesPowerTo ;
        sh:class dcpm:UtilityMeterType ;
        sh:name "suppliesPowerTo target" ;
        sh:description "POI supplies power to utility meter."
    ] ;
    sh:property [
        sh:path dcpm:hasValueStream ;
        sh:class dcpm:ValueStream ;
        sh:name "Value Stream" ;
        sh:description "Value stream program associated with this POI."
    ] .


# ========================================
# Utility Meter Shape
# ========================================

dcpm:UtilityMeterShape a sh:NodeShape ;
    sh:targetClass dcpm:UtilityMeterType ;
    sh:name "Utility Meter Shape for DCPM Power System" ;
    sh:description "SHACL shape defining required telemetry points and relationships for utility meters" ;

    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:or (
                [ sh:class dcpm:ImportActivePower ]
                [ sh:class dcpm:ActivePower ]
            ) ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Import Active Power Point" ;
        sh:description "Utility meter must track imported active power (kW)"
    ] ;
    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:or (
                [ sh:class dcpm:ImportActiveEnergy ]
                [ sh:class dcpm:ActiveEnergy ]
            ) ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloW-HR ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Import Active Energy Point" ;
        sh:description "Utility meter must track imported active energy (kWh)"
    ] ;

    # --- Relationships ---
    sh:property [
        sh:path dcpm:feeds ;
        sh:or (
            [ sh:class dcpm:TransformerType ]
            [ sh:class dcpm:SwitchgearType ]
            [ sh:class dcpm:BuswayType ]
            [ sh:class dcpm:ATSType ]
        ) ;
        sh:name "feeds target" ;
    ] ;
    sh:property [
        sh:path dcpm:suppliesPowerTo ;
        sh:or (
            [ sh:class dcpm:TransformerType ]
            [ sh:class dcpm:SwitchgearType ]
            [ sh:class dcpm:BuswayType ]
            [ sh:class dcpm:ATSType ]
        ) ;
        sh:name "suppliesPowerTo target" ;
    ] ;
    sh:property [
        sh:path dcpm:protectedBy ;
        sh:or (
            [ sh:class dcpm:SPDType ]
            [ sh:class dcpm:SwitchgearType ]
        ) ;
        sh:name "protectedBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:connectedTo ;
        sh:or (
            [ sh:class dcpm:PQMeterType ]
            [ sh:class dcpm:GatewayType ]
            [ sh:class dcpm:ControllerType ]
        ) ;
        sh:name "connectedTo target" ;
    ] ;
    sh:property [
        sh:path dcpm:controlledBy ;
        sh:class dcpm:ControllerType ;
        sh:name "controlledBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:hasLocation ;
        sh:or (
            [ sh:class dcpm:ElectricalRoom ]
            [ sh:class dcpm:SiteType ]
        ) ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path dcpm:hasDocument ;
        sh:class dcpm:Document ;
        sh:name "hasDocument target" ;
    ] ;
    sh:property [
        sh:path dcpm:hasSOP ;
        sh:class dcpm:SOP ;
        sh:name "hasSOP target" ;
    ] ;
    sh:property [
        sh:path dcpm:hasValueStream ;
        sh:class dcpm:ValueStream ;
        sh:name "hasValueStream target" ;
    ] .


# ========================================
# Transformer Shape
# ========================================

dcpm:TransformerShape a sh:NodeShape ;
    sh:targetClass dcpm:TransformerType ;
    sh:name "Transformer Shape for DCPM Power System" ;
    sh:description "SHACL shape requiring transformer to have monitoring, connectivity, and relationships" ;

    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class dcpm:PrimaryKV ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloV ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Primary Side Voltage Point" ;
        sh:description "Transformer must monitor primary side voltage (kV)"
    ] ;
    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class dcpm:SecondaryKV ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloV ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Secondary Side Voltage Point" ;
        sh:description "Transformer must monitor secondary side voltage (kV)"
    ] ;
    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class dcpm:ActivePower ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Active Power Point" ;
        sh:description "Transformer must monitor active power throughput (kW)"
    ] ;

    # --- Relationships ---
    sh:property [
        sh:path dcpm:feeds ;
        sh:or (
            [ sh:class dcpm:ATSType ]
            [ sh:class dcpm:SwitchgearType ]
            [ sh:class dcpm:UPSType ]
        ) ;
        sh:name "feeds target" ;
    ] ;
    sh:property [
        sh:path dcpm:fedBy ;
        sh:or (
            [ sh:class dcpm:UtilityMeterType ]
            [ sh:class dcpm:GeneratorSetType ]
            [ sh:class dcpm:SwitchgearType ]
        ) ;
        sh:name "fedBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:suppliesPowerTo ;
        sh:or (
            [ sh:class dcpm:ATSType ]
            [ sh:class dcpm:SwitchgearType ]
            [ sh:class dcpm:UPSType ]
        ) ;
        sh:name "suppliesPowerTo target" ;
    ] ;
    sh:property [
        sh:path dcpm:suppliedBy ;
        sh:or (
            [ sh:class dcpm:UtilityMeterType ]
            [ sh:class dcpm:GeneratorSetType ]
            [ sh:class dcpm:SwitchgearType ]
        ) ;
        sh:name "suppliedBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:primarySource ;
        sh:or (
            [ sh:class dcpm:UtilityMeterType ]
            [ sh:class dcpm:GeneratorSetType ]
        ) ;
        sh:name "primarySource" ;
    ] ;
    sh:property [
        sh:path dcpm:backupSource ;
        sh:or (
            [ sh:class dcpm:GeneratorSetType ]
            [ sh:class dcpm:UtilityMeterType ]
        ) ;
        sh:name "backupSource" ;
    ] ;
    sh:property [
        sh:path dcpm:protectedBy ;
        sh:or (
            [ sh:class dcpm:SwitchgearType ]
            [ sh:class dcpm:SPDType ]
        ) ;
        sh:name "protectedBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:connectedTo ;
        sh:or (
            [ sh:class dcpm:PQMeterType ]
            [ sh:class dcpm:GatewayType ]
            [ sh:class dcpm:ControllerType ]
        ) ;
        sh:name "connectedTo target" ;
    ] ;
    sh:property [
        sh:path dcpm:controlledBy ;
        sh:class dcpm:ControllerType ;
        sh:name "controlledBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:hasLocation ;
        sh:or (
            [ sh:class dcpm:ElectricalRoom ]
            [ sh:class dcpm:SiteType ]
        ) ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path dcpm:hasDocument ;
        sh:class dcpm:Document ;
        sh:name "hasDocument target" ;
    ] ;
    sh:property [
        sh:path dcpm:hasSOP ;
        sh:class dcpm:SOP ;
        sh:name "hasSOP target" ;
    ] .


# ========================================
# Switchgear Shape
# ========================================

dcpm:SwitchgearShape a sh:NodeShape ;
    sh:targetClass dcpm:SwitchgearType ;
    sh:name "Switchgear Shape for DCPM Power System" ;
    sh:description "SHACL shape requiring switchgear to have rated specifications, telemetry, and relationships" ;

    # --- Data Properties ---
    sh:property [
        sh:path dcpm:ratedVoltage ;
        sh:minCount 1 ;
        sh:name "Rated Voltage" ;
        sh:description "Switchgear must have a rated voltage specification"
    ] ;
    sh:property [
        sh:path dcpm:busbarRating ;
        sh:minCount 1 ;
        sh:datatype xsd:float ;
        sh:name "Busbar Current Rating" ;
        sh:description "Switchgear must specify busbar current rating in amperes"
    ] ;
    sh:property [
        sh:path dcpm:breakerCount ;
        sh:datatype xsd:integer ;
        sh:name "Breaker Count" ;
        sh:description "Number of circuit breakers installed in switchgear"
    ] ;

    # --- Telemetry [S] : simple_dc:switchgear-1 ---
    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class dcpm:ActivePower ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Bus Active Power Point" ;
        sh:description "Switchgear must monitor bus active power (kW)"
    ] ;
    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class dcpm:Voltage ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:V ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Bus Voltage Point" ;
        sh:description "Switchgear must monitor bus voltage (V)"
    ] ;
    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class dcpm:ApparentPower ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloVA ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Bus Apparent Power Point" ;
        sh:description "Switchgear must monitor bus apparent power (kVA)"
    ] ;
    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class dcpm:Frequency ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:HZ ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Bus Frequency Point" ;
        sh:description "Switchgear must monitor bus frequency (Hz)"
    ] ;

    # --- Relationships ---
    sh:property [
        sh:path dcpm:feeds ;
        sh:minCount 1 ;
        sh:or (
            [ sh:class dcpm:UPSType ]
            [ sh:class dcpm:BESSType ]
            [ sh:class dcpm:PDUType ]
            [ sh:class dcpm:TransformerType ]
            [ sh:class dcpm:BuswayType ]
            [ sh:class dcpm:MCCType ]
        ) ;
        sh:name "feeds target" ;
    ] ;
    sh:property [
        sh:path dcpm:fedBy ;
        sh:or (
            [ sh:class dcpm:ATSType ]
            [ sh:class dcpm:TransformerType ]
            [ sh:class dcpm:UtilityMeterType ]
            [ sh:class dcpm:BESSType ]
        ) ;
        sh:name "fedBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:suppliesPowerTo ;
        sh:or (
            [ sh:class dcpm:UPSType ]
            [ sh:class dcpm:BESSType ]
            [ sh:class dcpm:PDUType ]
            [ sh:class dcpm:TransformerType ]
            [ sh:class dcpm:BuswayType ]
            [ sh:class dcpm:MCCType ]
        ) ;
        sh:name "suppliesPowerTo target" ;
    ] ;
    sh:property [
        sh:path dcpm:suppliedBy ;
        sh:or (
            [ sh:class dcpm:ATSType ]
            [ sh:class dcpm:TransformerType ]
            [ sh:class dcpm:UtilityMeterType ]
            [ sh:class dcpm:BESSType ]
        ) ;
        sh:name "suppliedBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:primarySource ;
        sh:or (
            [ sh:class dcpm:ATSType ]
            [ sh:class dcpm:TransformerType ]
            [ sh:class dcpm:UtilityMeterType ]
        ) ;
        sh:name "primarySource" ;
    ] ;
    sh:property [
        sh:path dcpm:backupSource ;
        sh:or (
            [ sh:class dcpm:GeneratorSetType ]
            [ sh:class dcpm:BESSType ]
            [ sh:class dcpm:ATSType ]
        ) ;
        sh:name "backupSource" ;
    ] ;
    sh:property [
        sh:path dcpm:protects ;
        sh:or (
            [ sh:class dcpm:UPSType ]
            [ sh:class dcpm:TransformerType ]
            [ sh:class dcpm:PDUType ]
            [ sh:class dcpm:BESSType ]
            [ sh:class dcpm:FeederType ]
        ) ;
        sh:name "protects target" ;
    ] ;
    sh:property [
        sh:path dcpm:protectedBy ;
        sh:or (
            [ sh:class dcpm:SPDType ]
            [ sh:class dcpm:SwitchgearType ]
        ) ;
        sh:name "protectedBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:connectedTo ;
        sh:or (
            [ sh:class dcpm:PQMeterType ]
            [ sh:class dcpm:GatewayType ]
            [ sh:class dcpm:ControllerType ]
        ) ;
        sh:name "connectedTo target" ;
    ] ;
    sh:property [
        sh:path dcpm:controlledBy ;
        sh:class dcpm:ControllerType ;
        sh:name "controlledBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:hasLocation ;
        sh:class dcpm:ElectricalRoom ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path dcpm:hasDocument ;
        sh:class dcpm:Document ;
        sh:name "hasDocument target" ;
    ] ;
    sh:property [
        sh:path dcpm:hasSOP ;
        sh:class dcpm:SOP ;
        sh:name "hasSOP target" ;
    ] ;
    sh:property [
        sh:path dcpm:hasValueStream ;
        sh:class dcpm:ValueStream ;
        sh:name "hasValueStream target" ;
    ] .


# ========================================
# Generator Shape
# ========================================

dcpm:GeneratorShape a sh:NodeShape ;
    sh:targetClass dcpm:GeneratorSetType ;
    sh:name "Generator Shape for DCPM Power System" ;
    sh:description "SHACL shape requiring generator to have fuel monitoring, operating status, and relationships" ;

    # --- Data Properties ---
    sh:property [
        sh:path dcpm:fuelType ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "Fuel Type Metadata" ;
        sh:description "Generator must specify fuel type (Diesel, Natural Gas, Propane, etc.)"
    ] ;
    sh:property [
        sh:path dcpm:ratedPower ;
        sh:minCount 1 ;
        sh:property [
            sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
            sh:hasValue unit:KiloW ;
            sh:minCount 1 ;
        ] ;
        sh:name "Rated Power" ;
        sh:description "Generator must have rated power"
    ] ;

    # --- Telemetry  ---
    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class dcpm:FuelLevel ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:PERCENT ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Fuel Level Point" ;
        sh:description "Generator must monitor fuel level (%)"
    ] ;
    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class dcpm:ExportActivePower ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Output Active Power Point" ;
        sh:description "Generator must monitor output active power (kW)"
    ] ;
    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class dcpm:OutputVoltageLL ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloV ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Output Voltage Line-to-Line Point" ;
        sh:description "Generator must monitor output voltage line-to-line (kV)"
    ] ;
    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class dcpm:Frequency ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:HZ ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Frequency Point" ;
        sh:description "Generator must monitor output frequency (Hz)"
    ] ;

    # --- Relationships ---
    sh:property [
        sh:path dcpm:feeds ;
        sh:or (
            [ sh:class dcpm:ATSType ]
            [ sh:class dcpm:SwitchgearType ]
            [ sh:class dcpm:TransformerType ]
        ) ;
        sh:name "feeds target" ;
    ] ;
    sh:property [
        sh:path dcpm:suppliesPowerTo ;
        sh:or (
            [ sh:class dcpm:ATSType ]
            [ sh:class dcpm:SwitchgearType ]
            [ sh:class dcpm:TransformerType ]
        ) ;
        sh:name "suppliesPowerTo target" ;
    ] ;
    sh:property [
        sh:path dcpm:protectedBy ;
        sh:or (
            [ sh:class dcpm:SwitchgearType ]
            [ sh:class dcpm:SPDType ]
        ) ;
        sh:name "protectedBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:connectedTo ;
        sh:or (
            [ sh:class dcpm:GatewayType ]
            [ sh:class dcpm:ControllerType ]
            [ sh:class dcpm:PQMeterType ]
        ) ;
        sh:name "connectedTo target" ;
    ] ;
    sh:property [
        sh:path dcpm:controlledBy ;
        sh:class dcpm:ControllerType ;
        sh:name "controlledBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:hasLocation ;
        sh:or (
            [ sh:class dcpm:GeneratorYard ]
            [ sh:class dcpm:GeneratorRoom ]
        ) ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path dcpm:hasDocument ;
        sh:class dcpm:Document ;
        sh:name "hasDocument target" ;
    ] ;
    sh:property [
        sh:path dcpm:hasSOP ;
        sh:class dcpm:SOP ;
        sh:name "hasSOP target" ;
    ] .


# ========================================
# ATS/STS Shapes
# ========================================

dcpm:ATSShape a sh:NodeShape ;
    sh:targetClass dcpm:ATSType ;
    sh:name "Automatic Transfer Switch Shape for DCPM Power System" ;
    sh:description "SHACL shape requiring ATS to have source selection, monitoring, and relationships" ;

    # --- Data Properties ---
    sh:property [
        sh:path dcpm:transferTimeMS ;
        sh:datatype xsd:float ;
        sh:name "Transfer Time (ms)" ;
        sh:description "ATS transfer time during source changeover in milliseconds"
    ] ;
    sh:property [
        sh:path dcpm:numberOfPoles ;
        sh:minCount 1 ;
        sh:datatype xsd:integer ;
        sh:name "Number of Poles" ;
        sh:description "ATS must specify number of poles (1P, 2P, 3P, 4P)"
    ] ;

    # --- Relationships ---
    sh:property [
        sh:path dcpm:feeds ;
        sh:minCount 1 ;
        sh:or (
            [ sh:class dcpm:SwitchgearType ]
            [ sh:class dcpm:UPSType ]
            [ sh:class dcpm:TransformerType ]
        ) ;
        sh:name "feeds target" ;
    ] ;
    sh:property [
        sh:path dcpm:fedBy ;
        sh:or (
            [ sh:class dcpm:TransformerType ]
            [ sh:class dcpm:UtilityMeterType ]
            [ sh:class dcpm:GeneratorSetType ]
        ) ;
        sh:name "fedBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:suppliesPowerTo ;
        sh:or (
            [ sh:class dcpm:SwitchgearType ]
            [ sh:class dcpm:UPSType ]
            [ sh:class dcpm:TransformerType ]
        ) ;
        sh:name "suppliesPowerTo target" ;
    ] ;
    sh:property [
        sh:path dcpm:suppliedBy ;
        sh:or (
            [ sh:class dcpm:TransformerType ]
            [ sh:class dcpm:UtilityMeterType ]
            [ sh:class dcpm:GeneratorSetType ]
        ) ;
        sh:name "suppliedBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:primarySource ;
        sh:or (
            [ sh:class dcpm:TransformerType ]
            [ sh:class dcpm:UtilityMeterType ]
        ) ;
        sh:name "primarySource" ;
    ] ;
    sh:property [
        sh:path dcpm:backupSource ;
        sh:or (
            [ sh:class dcpm:GeneratorSetType ]
            [ sh:class dcpm:TransformerType ]
        ) ;
        sh:name "backupSource" ;
    ] ;
    sh:property [
        sh:path dcpm:protectedBy ;
        sh:or (
            [ sh:class dcpm:SwitchgearType ]
            [ sh:class dcpm:SPDType ]
        ) ;
        sh:name "protectedBy source" ;
