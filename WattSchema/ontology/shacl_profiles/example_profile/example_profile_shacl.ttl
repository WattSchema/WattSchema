        sh:path wattsch:feeds ;
        sh:or (
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:BuswayType ]
            [ sh:class wattsch:PDUType ]
        ) ;
        sh:name "feeds (discharge) target" ;
    ] ;
    sh:property [
        sh:path wattsch:fedBy ;
        sh:or (
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:BuswayType ]
        ) ;
        sh:name "fedBy (charge) source" ;
    ] ;
    sh:property [
        sh:path wattsch:suppliesPowerTo ;
        sh:or (
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:BuswayType ]
            [ sh:class wattsch:PDUType ]
        ) ;
        sh:name "suppliesPowerTo (discharge) target" ;
    ] ;
    sh:property [
        sh:path wattsch:suppliedBy ;
        sh:or (
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:BuswayType ]
        ) ;
        sh:name "suppliedBy (charge) source" ;
    ] ;
    sh:property [
        sh:path wattsch:primarySource ;
        sh:or (
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:BuswayType ]
        ) ;
        sh:name "primarySource (charging source)" ;
    ] ;
    sh:property [
        sh:path wattsch:protectedBy ;
        sh:or (
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:SPDType ]
        ) ;
        sh:name "protectedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:connectedTo ;
        sh:or (
            [ sh:class wattsch:BMSType ]
            [ sh:class wattsch:GatewayType ]
            [ sh:class wattsch:ControllerType ]
            [ sh:class wattsch:PQMeterType ]
        ) ;
        sh:name "connectedTo target" ;
    ] ;
    sh:property [
        sh:path wattsch:controlledBy ;
        sh:class wattsch:ControllerType ;
        sh:name "controlledBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:hasLocation ;
        sh:or (
            [ sh:class wattsch:ElectricalRoom ]
            [ sh:class wattsch:BatteryRoom ]
        ) ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasDocument ;
        sh:class wattsch:Document ;
        sh:name "hasDocument target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasSOP ;
        sh:class wattsch:SOP ;
        sh:name "hasSOP target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasValueStream ;
        sh:class wattsch:ValueStream ;
        sh:name "hasValueStream target" ;
    ] .


# ========================================
# BMS Shape
# ========================================

wattsch:BMSShape a sh:NodeShape ;
    sh:targetClass wattsch:BMSType ;
    sh:name "Battery Management System Shape for DCPM Power System" ;
    sh:description "SHACL shape for BMS monitoring and connection" ;

    sh:property [
        sh:path wattsch:connectedTo ;
        sh:or (
            [ sh:class wattsch:BESSType ]
            [ sh:class wattsch:UPSType ]
            [ sh:class wattsch:GatewayType ]
            [ sh:class wattsch:ControllerType ]
        ) ;
        sh:name "connectedTo target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasLocation ;
        sh:or (
            [ sh:class wattsch:BatteryRoom ]
            [ sh:class wattsch:ElectricalRoom ]
        ) ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasDocument ;
        sh:class wattsch:Document ;
        sh:name "hasDocument target" ;
    ] .


# ========================================
# PDU and Distribution Shapes
# ========================================

wattsch:PDUShape a sh:NodeShape ;
    sh:targetClass wattsch:PDUType ;
    sh:name "Power Distribution Unit Shape for DCPM Power System" ;
    sh:description "SHACL shape requiring PDU to have power monitoring, distribution, and relationships" ;

    # --- Data Properties ---
    sh:property [
        sh:path wattsch:circuitCount ;
        sh:minCount 1 ;
        sh:datatype xsd:integer ;
        sh:name "Circuit Count" ;
        sh:description "PDU must specify number of electrical circuits"
    ] ;

    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:or (
                [ sh:class wattsch:ImportActivePower ]
                [ sh:class wattsch:ActivePower ]
            ) ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Input Active Power" ;
        sh:description "PDU must monitor input active power (kW)"
    ] ;
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:or (
                [ sh:class wattsch:Voltage ]
                [ sh:class wattsch:InputVoltageLN ]
                [ sh:class wattsch:InputVoltageLL ]
            ) ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:V ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Voltage Monitoring" ;
        sh:description "PDU must monitor input voltage"
    ] ;

    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:Current ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:A ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Input Current Point" ;
        sh:description "PDU must monitor input current (A)"
    ] ;

    # --- Relationships ---
    sh:property [
        sh:path wattsch:feeds ;
        sh:or (
            [ sh:class wattsch:BuswayType ]
            [ sh:class wattsch:RackPDUType ]
            [ sh:class wattsch:ITRackType ]
        ) ;
        sh:name "feeds target" ;
    ] ;
    sh:property [
        sh:path wattsch:fedBy ;
        sh:or (
            [ sh:class wattsch:UPSType ]
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:BuswayType ]
            [ sh:class wattsch:STSType ]
        ) ;
        sh:name "fedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:suppliesPowerTo ;
        sh:or (
            [ sh:class wattsch:BuswayType ]
            [ sh:class wattsch:RackPDUType ]
            [ sh:class wattsch:ITRackType ]
        ) ;
        sh:name "suppliesPowerTo target" ;
    ] ;
    sh:property [
        sh:path wattsch:suppliedBy ;
        sh:or (
            [ sh:class wattsch:UPSType ]
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:BuswayType ]
            [ sh:class wattsch:STSType ]
        ) ;
        sh:name "suppliedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:primarySource ;
        sh:or (
            [ sh:class wattsch:UPSType ]
            [ sh:class wattsch:SwitchgearType ]
        ) ;
        sh:name "primarySource" ;
    ] ;
    sh:property [
        sh:path wattsch:backupSource ;
        sh:or (
            [ sh:class wattsch:UPSType ]
            [ sh:class wattsch:SwitchgearType ]
        ) ;
        sh:name "backupSource" ;
    ] ;
    sh:property [
        sh:path wattsch:protectedBy ;
        sh:or (
            [ sh:class wattsch:UPSType ]
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:SPDType ]
        ) ;
        sh:name "protectedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:protects ;
        sh:or (
            [ sh:class wattsch:RackPDUType ]
            [ sh:class wattsch:ITRackType ]
            [ sh:class wattsch:BuswayType ]
        ) ;
        sh:name "protects target" ;
    ] ;
    sh:property [
        sh:path wattsch:connectedTo ;
        sh:or (
            [ sh:class wattsch:GatewayType ]
            [ sh:class wattsch:ControllerType ]
            [ sh:class wattsch:PQMeterType ]
        ) ;
        sh:name "connectedTo target" ;
    ] ;
    sh:property [
        sh:path wattsch:controlledBy ;
        sh:class wattsch:ControllerType ;
        sh:name "controlledBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:hasLocation ;
        sh:or (
            [ sh:class wattsch:ElectricalRoom ]
            [ sh:class wattsch:DataHall ]
        ) ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasDocument ;
        sh:class wattsch:Document ;
        sh:name "hasDocument target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasSOP ;
        sh:class wattsch:SOP ;
        sh:name "hasSOP target" ;
    ] .

wattsch:RackPDUShape a sh:NodeShape ;
    sh:targetClass wattsch:RackPDUType ;
    sh:name "Rack PDU Shape for DCPM Power System" ;
    sh:description "SHACL shape requiring rack PDUs to have outlet-level power monitoring and relationships" ;

    # --- Data Properties ---
    sh:property [
        sh:path wattsch:outletCount ;
        sh:minCount 1 ;
        sh:datatype xsd:integer ;
        sh:name "Outlet Count" ;
        sh:description "Rack PDU must specify number of power outlets"
    ] ;
    sh:property [
        sh:path wattsch:circuitCount ;
        sh:minCount 1 ;
        sh:datatype xsd:integer ;
        sh:name "Circuit Count" ;
        sh:description "Rack PDU must specify number of circuits"
    ] ;

    # --- Telemetry ---
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:InputVoltageLN ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:V ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Input Voltage Point" ;
        sh:description "Rack PDU must monitor input line-to-neutral voltage (V)"
    ] ;
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:ExportActivePower ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Output Power Point" ;
        sh:description "Rack PDU must monitor output active power (kW)"
    ] ;

    # --- Relationships ---
    sh:property [
        sh:path wattsch:feeds ;
        sh:class wattsch:ITRackType ;
        sh:name "feeds target" ;
    ] ;
    sh:property [
        sh:path wattsch:fedBy ;
        sh:or (
            [ sh:class wattsch:PDUType ]
            [ sh:class wattsch:BuswayType ]
            [ sh:class wattsch:UPSType ]
        ) ;
        sh:name "fedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:suppliesPowerTo ;
        sh:class wattsch:ITRackType ;
        sh:name "suppliesPowerTo target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasLocation ;
        sh:class wattsch:DataHall ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasDocument ;
        sh:class wattsch:Document ;
        sh:name "hasDocument target" ;
    ] .


# ========================================
# Busway Shape
# ========================================

wattsch:BuswayShape a sh:NodeShape ;
    sh:targetClass wattsch:BuswayType ;
    sh:name "Busway Shape for DCPM Power System" ;
    sh:description "SHACL shape requiring busway to have monitoring, connections, and relationships" ;

    # --- Telemetry ---
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:InputActivePower ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Power Monitoring" ;
        sh:description "Busway must have power monitoring capabilities (kW)"
    ] ;

    # --- Relationships ---
    sh:property [
        sh:path wattsch:feeds ;
        sh:or (
            [ sh:class wattsch:PDUType ]
            [ sh:class wattsch:RackPDUType ]
            [ sh:class wattsch:RPPType ]
            [ sh:class wattsch:ITRackType ]
            [ sh:class wattsch:BESSType ]
        ) ;
        sh:name "feeds target" ;
    ] ;
    sh:property [
        sh:path wattsch:fedBy ;
        sh:or (
            [ sh:class wattsch:UPSType ]
            [ sh:class wattsch:PDUType ]
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:BESSType ]
        ) ;
        sh:name "fedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:suppliesPowerTo ;
        sh:or (
            [ sh:class wattsch:PDUType ]
            [ sh:class wattsch:RackPDUType ]
            [ sh:class wattsch:RPPType ]
            [ sh:class wattsch:ITRackType ]
            [ sh:class wattsch:BESSType ]
        ) ;
        sh:name "suppliesPowerTo target" ;
    ] ;
    sh:property [
        sh:path wattsch:suppliedBy ;
        sh:or (
            [ sh:class wattsch:UtilityMeterType ]
            [ sh:class wattsch:UPSType ]
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:BESSType ]
        ) ;
        sh:name "suppliedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:protectedBy ;
        sh:or (
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:UPSType ]
            [ sh:class wattsch:SPDType ]
        ) ;
        sh:name "protectedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:connectedTo ;
        sh:or (
            [ sh:class wattsch:GatewayType ]
            [ sh:class wattsch:ControllerType ]
            [ sh:class wattsch:PQMeterType ]
        ) ;
        sh:name "connectedTo target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasLocation ;
        sh:or (
            [ sh:class wattsch:DataHall ]
            [ sh:class wattsch:ElectricalRoom ]
        ) ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasDocument ;
        sh:class wattsch:Document ;
        sh:name "hasDocument target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasSOP ;
        sh:class wattsch:SOP ;
        sh:name "hasSOP target" ;
    ] .


# ========================================
# IT Rack Shape
# ========================================

wattsch:ITRackShape a sh:NodeShape ;
    sh:targetClass wattsch:ITRackType ;
    sh:name "IT Rack Shape for DCPM Power System" ;
    sh:description "Terminal load — consumes power only" ;

    # --- Telemetry ---
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:ActivePower ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Active Power" ;
        sh:description "IT Rack power consumption (kW)"
    ] ;

    # --- Relationships ---
    sh:property [
        sh:path wattsch:fedBy ;
        sh:or (
            [ sh:class wattsch:RackPDUType ]
            [ sh:class wattsch:BuswayType ]
            [ sh:class wattsch:PDUType ]
        ) ;
        sh:name "fedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:suppliedBy ;
        sh:or (
            [ sh:class wattsch:RackPDUType ]
            [ sh:class wattsch:BuswayType ]
            [ sh:class wattsch:PDUType ]
        ) ;
        sh:name "suppliedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:primarySource ;
        sh:or (
            [ sh:class wattsch:RackPDUType ]
            [ sh:class wattsch:BuswayType ]
            [ sh:class wattsch:PDUType ]
        ) ;
        sh:name "primarySource" ;
    ] ;
    sh:property [
        sh:path wattsch:backupSource ;
        sh:or (
            [ sh:class wattsch:RackPDUType ]
            [ sh:class wattsch:BuswayType ]
            [ sh:class wattsch:PDUType ]
        ) ;
        sh:name "backupSource" ;
    ] ;
    sh:property [
        sh:path wattsch:connectedTo ;
        sh:or (
            [ sh:class wattsch:GatewayType ]
            [ sh:class wattsch:ControllerType ]
        ) ;
        sh:name "connectedTo target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasLocation ;
        sh:class wattsch:DataHall ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasDocument ;
        sh:class wattsch:Document ;
        sh:name "hasDocument target" ;
    ] .


# ========================================
# Feeder Shape
# ========================================

wattsch:FeederShape a sh:NodeShape ;
    sh:targetClass wattsch:FeederType ;
    sh:name "Feeder Shape for DCPM Power System" ;
    sh:description "Individual feeder circuit within a switchgear" ;

    sh:property [
        sh:path wattsch:fedBy ;
        sh:class wattsch:SwitchgearType ;
        sh:name "fedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:feeds ;
        sh:or (
            [ sh:class wattsch:TransformerType ]
            [ sh:class wattsch:UPSType ]
            [ sh:class wattsch:PDUType ]
            [ sh:class wattsch:MCCType ]
        ) ;
        sh:name "feeds target" ;
    ] ;
    sh:property [
        sh:path wattsch:protectedBy ;
        sh:class wattsch:SwitchgearType ;
        sh:name "protectedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:hasDocument ;
        sh:class wattsch:Document ;
        sh:name "hasDocument target" ;
    ] .


# ========================================
# MCC Shape
# ========================================

wattsch:MCCShape a sh:NodeShape ;
    sh:targetClass wattsch:MCCType ;
    sh:name "Motor Control Center Shape for DCPM Power System" ;
    sh:description "SHACL shape for motor control centers" ;

    sh:property [
        sh:path wattsch:feeds ;
        sh:class wattsch:MotorFeederType ;
        sh:name "feeds target" ;
    ] ;
    sh:property [
        sh:path wattsch:fedBy ;
        sh:or (
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:TransformerType ]
            [ sh:class wattsch:PDUType ]
        ) ;
        sh:name "fedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:protects ;
        sh:class wattsch:MotorFeederType ;
        sh:name "protects target" ;
    ] ;
    sh:property [
        sh:path wattsch:controlledBy ;
        sh:class wattsch:ControllerType ;
        sh:name "controlledBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:hasLocation ;
        sh:class wattsch:ElectricalRoom ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasDocument ;
        sh:class wattsch:Document ;
        sh:name "hasDocument target" ;
    ] .


# ========================================
# Motor Feeder Shape
# ========================================

wattsch:MotorFeederShape a sh:NodeShape ;
    sh:targetClass wattsch:MotorFeederType ;
    sh:name "Motor Feeder Shape for DCPM Power System" ;
    sh:description "Individual motor starter/feeder within an MCC" ;

    sh:property [
        sh:path wattsch:fedBy ;
        sh:class wattsch:MCCType ;
        sh:name "fedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:protectedBy ;
        sh:class wattsch:MCCType ;
        sh:name "protectedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:controlledBy ;
        sh:class wattsch:ControllerType ;
        sh:name "controlledBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:hasDocument ;
        sh:class wattsch:Document ;
        sh:name "hasDocument target" ;
    ] .


# ========================================
# SPD Shape
# ========================================

wattsch:SPDShape a sh:NodeShape ;
    sh:targetClass wattsch:SPDType ;
    sh:name "Surge Protective Device Shape for DCPM Power System" ;
    sh:description "SHACL shape for surge protection devices" ;

    sh:property [
        sh:path wattsch:protects ;
        sh:or (
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:TransformerType ]
            [ sh:class wattsch:PDUType ]
            [ sh:class wattsch:UPSType ]
            [ sh:class wattsch:BuswayType ]
        ) ;
        sh:name "protects target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasLocation ;
        sh:class wattsch:ElectricalRoom ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasDocument ;
        sh:class wattsch:Document ;
        sh:name "hasDocument target" ;
    ] .


# ========================================
# Grounding Network Shape
# ========================================

wattsch:GroundingNetworkShape a sh:NodeShape ;
    sh:targetClass wattsch:GroundingNetworkType ;
    sh:name "Grounding Network Shape for DCPM Power System" ;
    sh:description "SHACL shape for grounding and bonding network" ;

    sh:property [
        sh:path wattsch:protects ;
        sh:class wattsch:PowerDeviceType ;
        sh:name "protects target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasDocument ;
        sh:class wattsch:Document ;
        sh:name "hasDocument target" ;
    ] .


# ========================================
# Power Quality and Monitoring Shapes
# ========================================

wattsch:PQMeterShape a sh:NodeShape ;
    sh:targetClass wattsch:PQMeterType ;
    sh:name "Power Quality Meter Shape for DCPM Power System" ;
    sh:description "SHACL shape requiring power quality meters to have comprehensive monitoring" ;

    # --- Telemetry  ---
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:THDV ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:PERCENT ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Total Harmonic Distortion Voltage" ;
        sh:description "PQ Meter must measure voltage THD (%)"
    ] ;
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:THDI ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:PERCENT ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Total Harmonic Distortion Current" ;
        sh:description "PQ Meter must measure current THD (%)"
    ] ;

    # --- Relationships ---
    sh:property [
        sh:path wattsch:connectedTo ;
        sh:class wattsch:PowerDeviceType ;
        sh:name "connectedTo target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasLocation ;
        sh:class wattsch:ElectricalRoom ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasDocument ;
        sh:class wattsch:Document ;
        sh:name "hasDocument target" ;
    ] .


# ========================================
# Control and Monitoring Infrastructure
# ========================================

wattsch:ControllerShape a sh:NodeShape ;
    sh:targetClass wattsch:ControllerType ;
    sh:name "Power System Controller Shape for DCPM" ;
    sh:description "SHACL shape requiring controllers to have monitoring, control, and connection capabilities" ;

    sh:property [
        sh:path wattsch:communicationProtocol ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "Communication Protocol" ;
        sh:description "Controller must support a communication protocol (Modbus TCP, BACnet, OPC UA, etc.)"
    ] ;
    sh:property [
        sh:path wattsch:ipAddress ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "IP Address" ;
        sh:description "Controller must have a network address"
    ] ;
    sh:property [
        sh:path wattsch:controls ;
        sh:class wattsch:PowerDeviceType ;
        sh:name "controls target" ;
    ] ;
    sh:property [
        sh:path wattsch:connectedTo ;
        sh:or (
            [ sh:class wattsch:GatewayType ]
            [ sh:class wattsch:PowerDeviceType ]
        ) ;
        sh:name "connectedTo target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasLocation ;
        sh:class wattsch:ElectricalRoom ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasDocument ;
        sh:class wattsch:Document ;
        sh:name "hasDocument target" ;
    ] .

wattsch:GatewayShape a sh:NodeShape ;
    sh:targetClass wattsch:GatewayType ;
    sh:name "Gateway/SCADA Shape for DCPM Power System" ;
    sh:description "SHACL shape requiring gateways to have communication and aggregation capabilities" ;

    sh:property [
        sh:path wattsch:communicationProtocol ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "Communication Protocol" ;
        sh:description "Gateway must support communication protocols"
    ] ;
    sh:property [
        sh:path wattsch:ipAddress ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "IP Address" ;
        sh:description "Gateway must have a network address"
    ] ;
    sh:property [
        sh:path wattsch:connectedTo ;
        sh:or (
            [ sh:class wattsch:ControllerType ]
            [ sh:class wattsch:PowerDeviceType ]
        ) ;
        sh:name "connectedTo target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasLocation ;
        sh:class wattsch:ElectricalRoom ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasDocument ;
        sh:class wattsch:Document ;
        sh:name "hasDocument target" ;
    ] .


# ========================================
# Physical Space Shapes
# ========================================

wattsch:ElectricalRoomShape a sh:NodeShape ;
    sh:targetClass wattsch:ElectricalRoom ;
    sh:name "Electrical Room Shape" ;

    sh:property [
        sh:path wattsch:containsEquipment ;
        sh:or (
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:TransformerType ]
            [ sh:class wattsch:UPSType ]
            [ sh:class wattsch:PDUType ]
            [ sh:class wattsch:ATSType ]
            [ sh:class wattsch:ControllerType ]
            [ sh:class wattsch:GatewayType ]
            [ sh:class wattsch:PQMeterType ]
            [ sh:class wattsch:SPDType ]
        ) ;
        sh:name "containsEquipment target" ;
    ] ;
    sh:property [
        sh:path wattsch:isLocationOf ;
        sh:class wattsch:PowerDeviceType ;
        sh:name "isLocationOf target" ;
    ] .

wattsch:DataHallShape a sh:NodeShape ;
    sh:targetClass wattsch:DataHall ;
    sh:name "Data Hall Shape" ;

    sh:property [
        sh:path wattsch:containsEquipment ;
        sh:or (
            [ sh:class wattsch:ITRackType ]
            [ sh:class wattsch:RackPDUType ]
            [ sh:class wattsch:BuswayType ]
            [ sh:class wattsch:PDUType ]
            [ sh:class wattsch:RPPType ]
        ) ;
        sh:name "containsEquipment target" ;
    ] ;
    sh:property [
        sh:path wattsch:isLocationOf ;
        sh:class wattsch:PowerDeviceType ;
        sh:name "isLocationOf target" ;
    ] .

wattsch:BatteryRoomShape a sh:NodeShape ;
    sh:targetClass wattsch:BatteryRoom ;
    sh:name "Battery Room Shape" ;

    sh:property [
        sh:path wattsch:containsEquipment ;
        sh:or (
            [ sh:class wattsch:BESSType ]
            [ sh:class wattsch:BMSType ]
        ) ;
        sh:name "containsEquipment target" ;
    ] ;
    sh:property [
        sh:path wattsch:isLocationOf ;
        sh:class wattsch:PowerDeviceType ;
        sh:name "isLocationOf target" ;
    ] .

wattsch:GeneratorYardShape a sh:NodeShape ;
    sh:targetClass wattsch:GeneratorYard ;
    sh:name "Generator Yard Shape" ;

    sh:property [
        sh:path wattsch:containsEquipment ;
        sh:class wattsch:GeneratorSetType ;
        sh:name "containsEquipment target" ;
    ] .

wattsch:GeneratorRoomShape a sh:NodeShape ;
    sh:targetClass wattsch:GeneratorRoom ;
    sh:name "Generator Room Shape" ;

    sh:property [
        sh:path wattsch:containsEquipment ;
        sh:class wattsch:GeneratorSetType ;
        sh:name "containsEquipment target" ;
    ] .


# ========================================
# Telemetry Shapes
# ========================================

wattsch:TelemetryPointShape a sh:NodeShape ;
    sh:targetClass wattsch:TelemetryPoint ;
    sh:name "Telemetry Point Shape" ;

    sh:property [
        sh:path wattsch:isTelemetryOf ;
        sh:or (
            [ sh:class wattsch:PowerDeviceType ]
            [ sh:class wattsch:TelemetryStream ]
        ) ;
        sh:name "isTelemetryOf target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasPhase ;
        sh:class wattsch:Phase ;
        sh:maxCount 1 ;
        sh:name "hasPhase target" ;
        sh:description "A telemetry point is associated with at most one electrical phase."
    ] .

wattsch:TelemetryStreamShape a sh:NodeShape ;
    sh:targetClass wattsch:TelemetryStream ;
    sh:name "Telemetry Stream Shape" ;

    sh:property [
        sh:path wattsch:isTelemetryStreamOf ;
        sh:class wattsch:PowerDeviceType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "isTelemetryStreamOf target" ;
        sh:description "A telemetry stream belongs to exactly one power device."
    ] ;
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:class wattsch:TelemetryPoint ;
        sh:name "hasTelemetryPoint target" ;
        sh:description "A stream contains one or more telemetry points."
    ] .
