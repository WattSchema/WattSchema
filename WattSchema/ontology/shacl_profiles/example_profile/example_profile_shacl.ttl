        sh:name "hasDocument target" ;
    ] .


# ========================================
# Busway Shape
# ========================================

dcpm:BuswayShape a sh:NodeShape ;
    sh:targetClass dcpm:BuswayType ;
    sh:name "Busway Shape for DCPM Power System" ;
    sh:description "SHACL shape requiring busway to have monitoring, connections, and relationships" ;

    # --- Telemetry ---
    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class dcpm:InputActivePower ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Power Monitoring" ;
        sh:description "Busway must have power monitoring capabilities (kW)"
    ] ;

    # --- Relationships ---
    sh:property [
        sh:path dcpm:feeds ;
        sh:or (
            [ sh:class dcpm:PDUType ]
            [ sh:class dcpm:RackPDUType ]
            [ sh:class dcpm:RPPType ]
            [ sh:class dcpm:ITRackType ]
            [ sh:class dcpm:BESSType ]
        ) ;
        sh:name "feeds target" ;
    ] ;
    sh:property [
        sh:path dcpm:fedBy ;
        sh:or (
            [ sh:class dcpm:UPSType ]
            [ sh:class dcpm:PDUType ]
            [ sh:class dcpm:SwitchgearType ]
            [ sh:class dcpm:BESSType ]
        ) ;
        sh:name "fedBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:suppliesPowerTo ;
        sh:or (
            [ sh:class dcpm:PDUType ]
            [ sh:class dcpm:RackPDUType ]
            [ sh:class dcpm:RPPType ]
            [ sh:class dcpm:ITRackType ]
            [ sh:class dcpm:BESSType ]
        ) ;
        sh:name "suppliesPowerTo target" ;
    ] ;
    sh:property [
        sh:path dcpm:suppliedBy ;
        sh:or (
            [ sh:class dcpm:UtilityMeterType ]
            [ sh:class dcpm:UPSType ]
            [ sh:class dcpm:SwitchgearType ]
            [ sh:class dcpm:BESSType ]
        ) ;
        sh:name "suppliedBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:protectedBy ;
        sh:or (
            [ sh:class dcpm:SwitchgearType ]
            [ sh:class dcpm:UPSType ]
            [ sh:class dcpm:SPDType ]
        ) ;
        sh:name "protectedBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:connectedTo ;
        sh:or (
            [ sh:class dcpm:GatewayType ]
            [ sh:class dcpm:ControllerType ]
            [ sh:class dcpm:PQMeterType ]
        ) ;
        sh:name "connectedTo target" ;
    ] ;
    sh:property [
        sh:path dcpm:hasLocation ;
        sh:or (
            [ sh:class dcpm:DataHall ]
            [ sh:class dcpm:ElectricalRoom ]
        ) ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path dcpm:hasDocument ;
        sh:class dcpm:Document ;
        sh:name "hasDocument target" ;
    ] ;
    sh:property [
        sh:path dcpm:hasSOP ;
        sh:class dcpm:SOP ;
        sh:name "hasSOP target" ;
    ] .


# ========================================
# IT Rack Shape
# ========================================

dcpm:ITRackShape a sh:NodeShape ;
    sh:targetClass dcpm:ITRackType ;
    sh:name "IT Rack Shape for DCPM Power System" ;
    sh:description "Terminal load — consumes power only" ;

    # --- Telemetry ---
    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class dcpm:ActivePower ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Active Power" ;
        sh:description "IT Rack power consumption (kW)"
    ] ;

    # --- Relationships ---
    sh:property [
        sh:path dcpm:fedBy ;
        sh:or (
            [ sh:class dcpm:RackPDUType ]
            [ sh:class dcpm:BuswayType ]
            [ sh:class dcpm:PDUType ]
        ) ;
        sh:name "fedBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:suppliedBy ;
        sh:or (
            [ sh:class dcpm:RackPDUType ]
            [ sh:class dcpm:BuswayType ]
            [ sh:class dcpm:PDUType ]
        ) ;
        sh:name "suppliedBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:primarySource ;
        sh:or (
            [ sh:class dcpm:RackPDUType ]
            [ sh:class dcpm:BuswayType ]
            [ sh:class dcpm:PDUType ]
        ) ;
        sh:name "primarySource" ;
    ] ;
    sh:property [
        sh:path dcpm:backupSource ;
        sh:or (
            [ sh:class dcpm:RackPDUType ]
            [ sh:class dcpm:BuswayType ]
            [ sh:class dcpm:PDUType ]
        ) ;
        sh:name "backupSource" ;
    ] ;
    sh:property [
        sh:path dcpm:connectedTo ;
        sh:or (
            [ sh:class dcpm:GatewayType ]
            [ sh:class dcpm:ControllerType ]
        ) ;
        sh:name "connectedTo target" ;
    ] ;
    sh:property [
        sh:path dcpm:hasLocation ;
        sh:class dcpm:DataHall ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path dcpm:hasDocument ;
        sh:class dcpm:Document ;
        sh:name "hasDocument target" ;
    ] .


# ========================================
# Feeder Shape
# ========================================

dcpm:FeederShape a sh:NodeShape ;
    sh:targetClass dcpm:FeederType ;
    sh:name "Feeder Shape for DCPM Power System" ;
    sh:description "Individual feeder circuit within a switchgear" ;

    sh:property [
        sh:path dcpm:fedBy ;
        sh:class dcpm:SwitchgearType ;
        sh:name "fedBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:feeds ;
        sh:or (
            [ sh:class dcpm:TransformerType ]
            [ sh:class dcpm:UPSType ]
            [ sh:class dcpm:PDUType ]
            [ sh:class dcpm:MCCType ]
        ) ;
        sh:name "feeds target" ;
    ] ;
    sh:property [
        sh:path dcpm:protectedBy ;
        sh:class dcpm:SwitchgearType ;
        sh:name "protectedBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:hasDocument ;
        sh:class dcpm:Document ;
        sh:name "hasDocument target" ;
    ] .


