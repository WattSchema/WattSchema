# ========================================
# PDU and Distribution Shapes
# ========================================

dcpm:PDUShape a sh:NodeShape ;
    sh:targetClass dcpm:PDUType ;
    sh:name "Power Distribution Unit Shape for DCPM Power System" ;
    sh:description "SHACL shape requiring PDU to have power monitoring, distribution, and relationships" ;

    # --- Data Properties ---
    sh:property [
        sh:path dcpm:circuitCount ;
        sh:minCount 1 ;
        sh:datatype xsd:integer ;
        sh:name "Circuit Count" ;
        sh:description "PDU must specify number of electrical circuits"
    ] ;

    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:or (
                [ sh:class dcpm:ImportActivePower ]
                [ sh:class dcpm:ActivePower ]
            ) ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Input Active Power" ;
        sh:description "PDU must monitor input active power (kW)"
    ] ;
    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:or (
                [ sh:class dcpm:Voltage ]
                [ sh:class dcpm:InputVoltageLN ]
                [ sh:class dcpm:InputVoltageLL ]
            ) ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:V ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Voltage Monitoring" ;
        sh:description "PDU must monitor input voltage"
    ] ;

    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class dcpm:Current ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:A ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Input Current Point" ;
        sh:description "PDU must monitor input current (A)"
    ] ;

    # --- Relationships ---
    sh:property [
        sh:path dcpm:feeds ;
        sh:or (
            [ sh:class dcpm:BuswayType ]
            [ sh:class dcpm:RackPDUType ]
            [ sh:class dcpm:ITRackType ]
        ) ;
        sh:name "feeds target" ;
    ] ;
    sh:property [
        sh:path dcpm:fedBy ;
        sh:or (
            [ sh:class dcpm:UPSType ]
            [ sh:class dcpm:SwitchgearType ]
            [ sh:class dcpm:BuswayType ]
            [ sh:class dcpm:STSType ]
        ) ;
        sh:name "fedBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:suppliesPowerTo ;
        sh:or (
            [ sh:class dcpm:BuswayType ]
            [ sh:class dcpm:RackPDUType ]
            [ sh:class dcpm:ITRackType ]
        ) ;
        sh:name "suppliesPowerTo target" ;
    ] ;
    sh:property [
        sh:path dcpm:suppliedBy ;
        sh:or (
            [ sh:class dcpm:UPSType ]
            [ sh:class dcpm:SwitchgearType ]
            [ sh:class dcpm:BuswayType ]
            [ sh:class dcpm:STSType ]
        ) ;
        sh:name "suppliedBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:primarySource ;
        sh:or (
            [ sh:class dcpm:UPSType ]
            [ sh:class dcpm:SwitchgearType ]
        ) ;
        sh:name "primarySource" ;
    ] ;
    sh:property [
        sh:path dcpm:backupSource ;
        sh:or (
            [ sh:class dcpm:UPSType ]
            [ sh:class dcpm:SwitchgearType ]
        ) ;
        sh:name "backupSource" ;
    ] ;
    sh:property [
        sh:path dcpm:protectedBy ;
        sh:or (
            [ sh:class dcpm:UPSType ]
            [ sh:class dcpm:SwitchgearType ]
            [ sh:class dcpm:SPDType ]
        ) ;
        sh:name "protectedBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:protects ;
        sh:or (
            [ sh:class dcpm:RackPDUType ]
            [ sh:class dcpm:ITRackType ]
            [ sh:class dcpm:BuswayType ]
        ) ;
        sh:name "protects target" ;
    ] ;
    sh:property [
        sh:path dcpm:connectedTo ;
        sh:or (
            [ sh:class dcpm:GatewayType ]
            [ sh:class dcpm:ControllerType ]
            [ sh:class dcpm:PQMeterType ]
        ) ;
        sh:name "connectedTo target" ;
    ] ;
    sh:property [
        sh:path dcpm:controlledBy ;
        sh:class dcpm:ControllerType ;
        sh:name "controlledBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:hasLocation ;
        sh:or (
            [ sh:class dcpm:ElectricalRoom ]
            [ sh:class dcpm:DataHall ]
        ) ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path dcpm:hasDocument ;
        sh:class dcpm:Document ;
        sh:name "hasDocument target" ;
    ] ;
    sh:property [
        sh:path dcpm:hasSOP ;
        sh:class dcpm:SOP ;
        sh:name "hasSOP target" ;
    ] .

dcpm:RackPDUShape a sh:NodeShape ;
    sh:targetClass dcpm:RackPDUType ;
