    ] ;
    sh:property [
        sh:path dcpm:hasDocument ;
        sh:class dcpm:Document ;
        sh:name "hasDocument target" ;
    ] .


# ========================================
# Motor Feeder Shape
# ========================================

dcpm:MotorFeederShape a sh:NodeShape ;
    sh:targetClass dcpm:MotorFeederType ;
    sh:name "Motor Feeder Shape for DCPM Power System" ;
    sh:description "Individual motor starter/feeder within an MCC" ;

    sh:property [
