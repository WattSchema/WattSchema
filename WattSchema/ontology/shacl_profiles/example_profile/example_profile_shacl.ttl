            sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
            sh:hasValue unit:KiloW-HR ;
            sh:minCount 1 ;
        ] ;
        sh:name "Rated Storage Capacity" ;
        sh:description "BESS must specify rated energy storage capacity (kWh)"
    ] ;

    # --- Telemetry  ---
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:SoC ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:PERCENT ;
