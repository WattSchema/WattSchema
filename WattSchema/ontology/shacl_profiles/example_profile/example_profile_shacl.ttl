@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix wattsch: <https://qcells.com/schema/dcpm/#> .
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rec:  <https://w3id.org/rec#> .


# ========================================
# Site Shape
# ========================================

wattsch:SiteShape a sh:NodeShape ;
    sh:targetClass wattsch:SiteType ;
    sh:name "Site Shape for DCPM Power System" ;
    sh:description "SHACL shape requiring each site to have proper power system components" ;

    sh:property [
        sh:path wattsch:latitude ;
        sh:datatype xsd:float ;
        sh:minCount 1 ;
        sh:name "Site Latitude" ;
        sh:description "Site must include latitude in decimal degrees"
    ] ;
    sh:property [
        sh:path wattsch:longitude ;
        sh:datatype xsd:float ;
        sh:minCount 1 ;
        sh:name "Site Longitude" ;
        sh:description "Site must include longitude in decimal degrees"
    ] ;
    sh:property [
        sh:path wattsch:siteId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:name "Site Identifier" ;
        sh:description "Site must have a unique identifier"
    ] ;
    sh:property [
        sh:path wattsch:hasPointOfInterconnection ;
        sh:class wattsch:PointOfInterconnection ;
        sh:name "Point of Interconnection" ;
        sh:description "Site's grid connection point(s)."
    ] ;
    sh:property [
        sh:path wattsch:hasValueStream ;
        sh:class wattsch:ValueStream ;
        sh:name "Value Stream" ;
        sh:description "Revenue or cost optimization pathway associated with the site."
    ] ;
    sh:property [
        sh:path wattsch:containsEquipment ;
        sh:class wattsch:PowerDeviceType ;
        sh:name "Contains Equipment" ;
        sh:description "Power devices physically contained within the site."
    ] ;
    sh:property [
        sh:path wattsch:isLocationOf ;
        sh:class wattsch:PowerDeviceType ;
        sh:name "Is Location Of" ;
        sh:description "Power devices located at this site."
    ] ;
    sh:property [
        sh:path rec:ownedBy ;
        sh:class rec:Organization ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:name "Owned By" ;
        sh:description "Site must be owned by exactly one Organization"
    ] .


# ========================================
# Point of Interconnection Shape
# ========================================

wattsch:POIShape a sh:NodeShape ;
    sh:targetClass wattsch:PointOfInterconnection ;
    sh:name "Point of Interconnection Shape for DCPM Power System" ;
    sh:description "SHACL shape for grid interconnection points" ;

    sh:property [
        sh:path wattsch:feeds ;
        sh:class wattsch:UtilityMeterType ;
        sh:name "feeds target" ;
        sh:description "POI feeds utility meter."
    ] ;
    sh:property [
        sh:path wattsch:suppliesPowerTo ;
        sh:class wattsch:UtilityMeterType ;
        sh:name "suppliesPowerTo target" ;
        sh:description "POI supplies power to utility meter."
    ] ;
    sh:property [
        sh:path wattsch:hasValueStream ;
        sh:class wattsch:ValueStream ;
        sh:name "Value Stream" ;
        sh:description "Value stream program associated with this POI."
    ] .


# ========================================
# Utility Meter Shape
# ========================================

wattsch:UtilityMeterShape a sh:NodeShape ;
    sh:targetClass wattsch:UtilityMeterType ;
    sh:name "Utility Meter Shape for DCPM Power System" ;
    sh:description "SHACL shape defining required telemetry points and relationships for utility meters" ;

    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:or (
                [ sh:class wattsch:ImportActivePower ]
                [ sh:class wattsch:ActivePower ]
            ) ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Import Active Power Point" ;
        sh:description "Utility meter must track imported active power (kW)"
    ] ;
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:or (
                [ sh:class wattsch:ImportActiveEnergy ]
                [ sh:class wattsch:ActiveEnergy ]
            ) ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloW-HR ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Import Active Energy Point" ;
        sh:description "Utility meter must track imported active energy (kWh)"
    ] ;

    # --- Relationships ---
    sh:property [
        sh:path wattsch:feeds ;
        sh:or (
            [ sh:class wattsch:TransformerType ]
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:BuswayType ]
            [ sh:class wattsch:ATSType ]
        ) ;
        sh:name "feeds target" ;
    ] ;
    sh:property [
        sh:path wattsch:suppliesPowerTo ;
        sh:or (
            [ sh:class wattsch:TransformerType ]
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:BuswayType ]
            [ sh:class wattsch:ATSType ]
        ) ;
        sh:name "suppliesPowerTo target" ;
    ] ;
    sh:property [
        sh:path wattsch:protectedBy ;
        sh:or (
            [ sh:class wattsch:SPDType ]
            [ sh:class wattsch:SwitchgearType ]
        ) ;
        sh:name "protectedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:connectedTo ;
        sh:or (
            [ sh:class wattsch:PQMeterType ]
            [ sh:class wattsch:GatewayType ]
            [ sh:class wattsch:ControllerType ]
        ) ;
        sh:name "connectedTo target" ;
    ] ;
    sh:property [
        sh:path wattsch:controlledBy ;
        sh:class wattsch:ControllerType ;
        sh:name "controlledBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:hasLocation ;
        sh:or (
            [ sh:class wattsch:ElectricalRoom ]
            [ sh:class wattsch:SiteType ]
        ) ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasDocument ;
        sh:class wattsch:Document ;
        sh:name "hasDocument target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasSOP ;
        sh:class wattsch:SOP ;
        sh:name "hasSOP target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasValueStream ;
        sh:class wattsch:ValueStream ;
        sh:name "hasValueStream target" ;
    ] .


# ========================================
# Transformer Shape
# ========================================

wattsch:TransformerShape a sh:NodeShape ;
    sh:targetClass wattsch:TransformerType ;
    sh:name "Transformer Shape for DCPM Power System" ;
    sh:description "SHACL shape requiring transformer to have monitoring, connectivity, and relationships" ;

    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:PrimaryKV ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloV ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Primary Side Voltage Point" ;
        sh:description "Transformer must monitor primary side voltage (kV)"
    ] ;
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:SecondaryKV ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloV ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Secondary Side Voltage Point" ;
        sh:description "Transformer must monitor secondary side voltage (kV)"
    ] ;
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:ActivePower ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Active Power Point" ;
        sh:description "Transformer must monitor active power throughput (kW)"
    ] ;

    # --- Relationships ---
    sh:property [
        sh:path wattsch:feeds ;
        sh:or (
            [ sh:class wattsch:ATSType ]
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:UPSType ]
        ) ;
        sh:name "feeds target" ;
    ] ;
    sh:property [
        sh:path wattsch:fedBy ;
        sh:or (
            [ sh:class wattsch:UtilityMeterType ]
            [ sh:class wattsch:GeneratorSetType ]
            [ sh:class wattsch:SwitchgearType ]
        ) ;
        sh:name "fedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:suppliesPowerTo ;
        sh:or (
            [ sh:class wattsch:ATSType ]
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:UPSType ]
        ) ;
        sh:name "suppliesPowerTo target" ;
    ] ;
    sh:property [
        sh:path wattsch:suppliedBy ;
        sh:or (
            [ sh:class wattsch:UtilityMeterType ]
            [ sh:class wattsch:GeneratorSetType ]
            [ sh:class wattsch:SwitchgearType ]
        ) ;
        sh:name "suppliedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:primarySource ;
        sh:or (
            [ sh:class wattsch:UtilityMeterType ]
            [ sh:class wattsch:GeneratorSetType ]
        ) ;
        sh:name "primarySource" ;
    ] ;
    sh:property [
        sh:path wattsch:backupSource ;
        sh:or (
            [ sh:class wattsch:GeneratorSetType ]
            [ sh:class wattsch:UtilityMeterType ]
        ) ;
        sh:name "backupSource" ;
    ] ;
    sh:property [
        sh:path wattsch:protectedBy ;
        sh:or (
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:SPDType ]
        ) ;
        sh:name "protectedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:connectedTo ;
        sh:or (
            [ sh:class wattsch:PQMeterType ]
            [ sh:class wattsch:GatewayType ]
            [ sh:class wattsch:ControllerType ]
        ) ;
        sh:name "connectedTo target" ;
    ] ;
    sh:property [
        sh:path wattsch:controlledBy ;
        sh:class wattsch:ControllerType ;
        sh:name "controlledBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:hasLocation ;
        sh:or (
            [ sh:class wattsch:ElectricalRoom ]
            [ sh:class wattsch:SiteType ]
        ) ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasDocument ;
        sh:class wattsch:Document ;
        sh:name "hasDocument target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasSOP ;
        sh:class wattsch:SOP ;
        sh:name "hasSOP target" ;
    ] .


# ========================================
# Switchgear Shape
# ========================================

wattsch:SwitchgearShape a sh:NodeShape ;
    sh:targetClass wattsch:SwitchgearType ;
    sh:name "Switchgear Shape for DCPM Power System" ;
    sh:description "SHACL shape requiring switchgear to have rated specifications, telemetry, and relationships" ;

    # --- Data Properties ---
    sh:property [
        sh:path wattsch:ratedVoltage ;
        sh:minCount 1 ;
        sh:name "Rated Voltage" ;
        sh:description "Switchgear must have a rated voltage specification"
    ] ;
    sh:property [
        sh:path wattsch:busbarRating ;
        sh:minCount 1 ;
        sh:datatype xsd:float ;
        sh:name "Busbar Current Rating" ;
        sh:description "Switchgear must specify busbar current rating in amperes"
    ] ;
    sh:property [
        sh:path wattsch:breakerCount ;
        sh:datatype xsd:integer ;
        sh:name "Breaker Count" ;
        sh:description "Number of circuit breakers installed in switchgear"
    ] ;

    # --- Telemetry [S] : simple_dc:switchgear-1 ---
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:ActivePower ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Bus Active Power Point" ;
        sh:description "Switchgear must monitor bus active power (kW)"
    ] ;
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:Voltage ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:V ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Bus Voltage Point" ;
        sh:description "Switchgear must monitor bus voltage (V)"
    ] ;
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:ApparentPower ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloVA ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Bus Apparent Power Point" ;
        sh:description "Switchgear must monitor bus apparent power (kVA)"
    ] ;
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:Frequency ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:HZ ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Bus Frequency Point" ;
        sh:description "Switchgear must monitor bus frequency (Hz)"
    ] ;

    # --- Relationships ---
    sh:property [
        sh:path wattsch:feeds ;
        sh:minCount 1 ;
        sh:or (
            [ sh:class wattsch:UPSType ]
            [ sh:class wattsch:BESSType ]
            [ sh:class wattsch:PDUType ]
            [ sh:class wattsch:TransformerType ]
            [ sh:class wattsch:BuswayType ]
            [ sh:class wattsch:MCCType ]
        ) ;
        sh:name "feeds target" ;
    ] ;
    sh:property [
        sh:path wattsch:fedBy ;
        sh:or (
            [ sh:class wattsch:ATSType ]
            [ sh:class wattsch:TransformerType ]
            [ sh:class wattsch:UtilityMeterType ]
            [ sh:class wattsch:BESSType ]
        ) ;
        sh:name "fedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:suppliesPowerTo ;
        sh:or (
            [ sh:class wattsch:UPSType ]
            [ sh:class wattsch:BESSType ]
            [ sh:class wattsch:PDUType ]
            [ sh:class wattsch:TransformerType ]
            [ sh:class wattsch:BuswayType ]
            [ sh:class wattsch:MCCType ]
        ) ;
        sh:name "suppliesPowerTo target" ;
    ] ;
    sh:property [
        sh:path wattsch:suppliedBy ;
        sh:or (
            [ sh:class wattsch:ATSType ]
            [ sh:class wattsch:TransformerType ]
            [ sh:class wattsch:UtilityMeterType ]
            [ sh:class wattsch:BESSType ]
        ) ;
        sh:name "suppliedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:primarySource ;
        sh:or (
            [ sh:class wattsch:ATSType ]
            [ sh:class wattsch:TransformerType ]
            [ sh:class wattsch:UtilityMeterType ]
        ) ;
        sh:name "primarySource" ;
    ] ;
    sh:property [
        sh:path wattsch:backupSource ;
        sh:or (
            [ sh:class wattsch:GeneratorSetType ]
            [ sh:class wattsch:BESSType ]
            [ sh:class wattsch:ATSType ]
        ) ;
        sh:name "backupSource" ;
    ] ;
    sh:property [
        sh:path wattsch:protects ;
        sh:or (
            [ sh:class wattsch:UPSType ]
            [ sh:class wattsch:TransformerType ]
            [ sh:class wattsch:PDUType ]
            [ sh:class wattsch:BESSType ]
            [ sh:class wattsch:FeederType ]
        ) ;
        sh:name "protects target" ;
    ] ;
    sh:property [
        sh:path wattsch:protectedBy ;
        sh:or (
            [ sh:class wattsch:SPDType ]
            [ sh:class wattsch:SwitchgearType ]
        ) ;
        sh:name "protectedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:connectedTo ;
        sh:or (
            [ sh:class wattsch:PQMeterType ]
            [ sh:class wattsch:GatewayType ]
            [ sh:class wattsch:ControllerType ]
        ) ;
        sh:name "connectedTo target" ;
    ] ;
    sh:property [
        sh:path wattsch:controlledBy ;
        sh:class wattsch:ControllerType ;
        sh:name "controlledBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:hasLocation ;
        sh:class wattsch:ElectricalRoom ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasDocument ;
        sh:class wattsch:Document ;
        sh:name "hasDocument target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasSOP ;
        sh:class wattsch:SOP ;
        sh:name "hasSOP target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasValueStream ;
        sh:class wattsch:ValueStream ;
        sh:name "hasValueStream target" ;
    ] .


# ========================================
# Generator Shape
# ========================================

wattsch:GeneratorShape a sh:NodeShape ;
    sh:targetClass wattsch:GeneratorSetType ;
    sh:name "Generator Shape for DCPM Power System" ;
    sh:description "SHACL shape requiring generator to have fuel monitoring, operating status, and relationships" ;

    # --- Data Properties ---
    sh:property [
        sh:path wattsch:fuelType ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "Fuel Type Metadata" ;
        sh:description "Generator must specify fuel type (Diesel, Natural Gas, Propane, etc.)"
    ] ;
    sh:property [
        sh:path wattsch:ratedPower ;
        sh:minCount 1 ;
        sh:property [
            sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
            sh:hasValue unit:KiloW ;
            sh:minCount 1 ;
        ] ;
        sh:name "Rated Power" ;
        sh:description "Generator must have rated power"
    ] ;

    # --- Telemetry  ---
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:FuelLevel ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:PERCENT ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Fuel Level Point" ;
        sh:description "Generator must monitor fuel level (%)"
    ] ;
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:ExportActivePower ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Output Active Power Point" ;
        sh:description "Generator must monitor output active power (kW)"
    ] ;
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:OutputVoltageLL ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloV ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Output Voltage Line-to-Line Point" ;
        sh:description "Generator must monitor output voltage line-to-line (kV)"
    ] ;
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:Frequency ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:HZ ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Frequency Point" ;
        sh:description "Generator must monitor output frequency (Hz)"
    ] ;

    # --- Relationships ---
    sh:property [
        sh:path wattsch:feeds ;
        sh:or (
            [ sh:class wattsch:ATSType ]
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:TransformerType ]
        ) ;
        sh:name "feeds target" ;
    ] ;
    sh:property [
        sh:path wattsch:suppliesPowerTo ;
        sh:or (
            [ sh:class wattsch:ATSType ]
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:TransformerType ]
        ) ;
        sh:name "suppliesPowerTo target" ;
    ] ;
    sh:property [
        sh:path wattsch:protectedBy ;
        sh:or (
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:SPDType ]
        ) ;
        sh:name "protectedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:connectedTo ;
        sh:or (
            [ sh:class wattsch:GatewayType ]
            [ sh:class wattsch:ControllerType ]
            [ sh:class wattsch:PQMeterType ]
        ) ;
        sh:name "connectedTo target" ;
    ] ;
    sh:property [
        sh:path wattsch:controlledBy ;
        sh:class wattsch:ControllerType ;
        sh:name "controlledBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:hasLocation ;
        sh:or (
            [ sh:class wattsch:GeneratorYard ]
            [ sh:class wattsch:GeneratorRoom ]
        ) ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasDocument ;
        sh:class wattsch:Document ;
        sh:name "hasDocument target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasSOP ;
        sh:class wattsch:SOP ;
        sh:name "hasSOP target" ;
    ] .


# ========================================
# ATS/STS Shapes
# ========================================

wattsch:ATSShape a sh:NodeShape ;
    sh:targetClass wattsch:ATSType ;
    sh:name "Automatic Transfer Switch Shape for DCPM Power System" ;
    sh:description "SHACL shape requiring ATS to have source selection, monitoring, and relationships" ;

    # --- Data Properties ---
    sh:property [
        sh:path wattsch:transferTimeMS ;
        sh:datatype xsd:float ;
        sh:name "Transfer Time (ms)" ;
        sh:description "ATS transfer time during source changeover in milliseconds"
    ] ;
    sh:property [
        sh:path wattsch:numberOfPoles ;
        sh:minCount 1 ;
        sh:datatype xsd:integer ;
        sh:name "Number of Poles" ;
        sh:description "ATS must specify number of poles (1P, 2P, 3P, 4P)"
    ] ;

    # --- Relationships ---
    sh:property [
        sh:path wattsch:feeds ;
        sh:minCount 1 ;
        sh:or (
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:UPSType ]
            [ sh:class wattsch:TransformerType ]
        ) ;
        sh:name "feeds target" ;
    ] ;
    sh:property [
        sh:path wattsch:fedBy ;
        sh:or (
            [ sh:class wattsch:TransformerType ]
            [ sh:class wattsch:UtilityMeterType ]
            [ sh:class wattsch:GeneratorSetType ]
        ) ;
        sh:name "fedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:suppliesPowerTo ;
        sh:or (
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:UPSType ]
            [ sh:class wattsch:TransformerType ]
        ) ;
        sh:name "suppliesPowerTo target" ;
    ] ;
    sh:property [
        sh:path wattsch:suppliedBy ;
        sh:or (
            [ sh:class wattsch:TransformerType ]
            [ sh:class wattsch:UtilityMeterType ]
            [ sh:class wattsch:GeneratorSetType ]
        ) ;
        sh:name "suppliedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:primarySource ;
        sh:or (
            [ sh:class wattsch:TransformerType ]
            [ sh:class wattsch:UtilityMeterType ]
        ) ;
        sh:name "primarySource" ;
    ] ;
    sh:property [
        sh:path wattsch:backupSource ;
        sh:or (
            [ sh:class wattsch:GeneratorSetType ]
            [ sh:class wattsch:TransformerType ]
        ) ;
        sh:name "backupSource" ;
    ] ;
    sh:property [
        sh:path wattsch:protectedBy ;
        sh:or (
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:SPDType ]
        ) ;
        sh:name "protectedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:connectedTo ;
        sh:or (
            [ sh:class wattsch:GatewayType ]
            [ sh:class wattsch:ControllerType ]
            [ sh:class wattsch:PQMeterType ]
        ) ;
        sh:name "connectedTo target" ;
    ] ;
    sh:property [
        sh:path wattsch:controlledBy ;
        sh:class wattsch:ControllerType ;
        sh:name "controlledBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:hasLocation ;
        sh:class wattsch:ElectricalRoom ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasDocument ;
        sh:class wattsch:Document ;
        sh:name "hasDocument target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasSOP ;
        sh:class wattsch:SOP ;
        sh:name "hasSOP target" ;
    ] .

wattsch:STSShape a sh:NodeShape ;
    sh:targetClass wattsch:STSType ;
    sh:name "Static Transfer Switch Shape for DCPM Power System" ;
    sh:description "SHACL shape requiring STS to have advanced monitoring and control capabilities" ;

    sh:property [
        sh:path wattsch:transferTimeMS ;
        sh:minCount 1 ;
        sh:datatype xsd:float ;
        sh:name "Transfer Time (ms)" ;
        sh:description "STS must specify ultra-fast transfer time in milliseconds"
    ] ;
    sh:property [
        sh:path wattsch:numberOfPoles ;
        sh:minCount 1 ;
        sh:datatype xsd:integer ;
        sh:name "Number of Poles" ;
        sh:description "STS must specify number of poles"
    ] .


# ========================================
# UPS Shape
# ========================================

wattsch:UPSShape a sh:NodeShape ;
    sh:targetClass wattsch:UPSType ;
    sh:name "Uninterruptible Power Supply Shape for DCPM Power System" ;
    sh:description "SHACL shape requiring UPS to have battery health, runtime monitoring, and relationships" ;

    # --- Telemetry  ---
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:SoC ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:PERCENT ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "State of Charge Point" ;
        sh:description "UPS must monitor battery state of charge (%)"
    ] ;
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:SoH ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:PERCENT ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "State of Health Point" ;
        sh:description "UPS must monitor battery state of health (%)"
    ] ;
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:RemainingTime ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:MIN ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Remaining Backup Time Point" ;
        sh:description "UPS must provide remaining runtime estimation (min)"
    ] ;

    # --- Telemetry [S] : simple_dc:ups-1 ---
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:ImportActivePower ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Input Active Power Point" ;
        sh:description "UPS must monitor input active power (kW)"
    ] ;
    sh:property [
        sh:path wattsch:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class wattsch:ExportActivePower ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Output Active Power Point" ;
        sh:description "UPS must monitor output active power (kW)"
    ] ;

    # --- Relationships ---
    sh:property [
        sh:path wattsch:feeds ;
        sh:minCount 1 ;
        sh:or (
            [ sh:class wattsch:PDUType ]
            [ sh:class wattsch:BuswayType ]
            [ sh:class wattsch:STSType ]
        ) ;
        sh:name "feeds target" ;
    ] ;
    sh:property [
        sh:path wattsch:fedBy ;
        sh:or (
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:ATSType ]
            [ sh:class wattsch:TransformerType ]
        ) ;
        sh:name "fedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:suppliesPowerTo ;
        sh:or (
            [ sh:class wattsch:PDUType ]
            [ sh:class wattsch:BuswayType ]
            [ sh:class wattsch:STSType ]
        ) ;
        sh:name "suppliesPowerTo target" ;
    ] ;
    sh:property [
        sh:path wattsch:suppliedBy ;
        sh:or (
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:ATSType ]
            [ sh:class wattsch:TransformerType ]
        ) ;
        sh:name "suppliedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:primarySource ;
        sh:or (
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:ATSType ]
        ) ;
        sh:name "primarySource" ;
    ] ;
    sh:property [
        sh:path wattsch:backupSource ;
        sh:or (
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:ATSType ]
        ) ;
        sh:name "backupSource" ;
    ] ;
    sh:property [
        sh:path wattsch:protects ;
        sh:or (
            [ sh:class wattsch:PDUType ]
            [ sh:class wattsch:BuswayType ]
        ) ;
        sh:name "protects target" ;
    ] ;
    sh:property [
        sh:path wattsch:protectedBy ;
        sh:or (
            [ sh:class wattsch:SwitchgearType ]
            [ sh:class wattsch:SPDType ]
        ) ;
        sh:name "protectedBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:connectedTo ;
        sh:or (
            [ sh:class wattsch:BMSType ]
            [ sh:class wattsch:GatewayType ]
            [ sh:class wattsch:ControllerType ]
            [ sh:class wattsch:PQMeterType ]
        ) ;
        sh:name "connectedTo target" ;
    ] ;
    sh:property [
        sh:path wattsch:controlledBy ;
        sh:class wattsch:ControllerType ;
        sh:name "controlledBy source" ;
    ] ;
    sh:property [
        sh:path wattsch:hasLocation ;
        sh:class wattsch:ElectricalRoom ;
        sh:name "hasLocation target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasDocument ;
        sh:class wattsch:Document ;
        sh:name "hasDocument target" ;
    ] ;
    sh:property [
        sh:path wattsch:hasSOP ;
        sh:class wattsch:SOP ;
        sh:name "hasSOP target" ;
    ] .


# ========================================
# BESS Shape
# ========================================

wattsch:BESSShape a sh:NodeShape ;
    sh:targetClass wattsch:BESSType ;
    sh:name "Battery Energy Storage System Shape for DCPM Power System" ;
    sh:description "SHACL shape requiring BESS to have monitoring capabilities and relationships" ;

    # --- Data Properties ---
    sh:property [
