        sh:name "hasSOP target" ;
    ] .

dcpm:STSShape a sh:NodeShape ;
    sh:targetClass dcpm:STSType ;
    sh:name "Static Transfer Switch Shape for DCPM Power System" ;
    sh:description "SHACL shape requiring STS to have advanced monitoring and control capabilities" ;

    sh:property [
        sh:path dcpm:transferTimeMS ;
        sh:minCount 1 ;
        sh:datatype xsd:float ;
        sh:name "Transfer Time (ms)" ;
        sh:description "STS must specify ultra-fast transfer time in milliseconds"
    ] ;
    sh:property [
        sh:path dcpm:numberOfPoles ;
        sh:minCount 1 ;
        sh:datatype xsd:integer ;
        sh:name "Number of Poles" ;
        sh:description "STS must specify number of poles"
    ] .


# ========================================
# UPS Shape
# ========================================

dcpm:UPSShape a sh:NodeShape ;
    sh:targetClass dcpm:UPSType ;
    sh:name "Uninterruptible Power Supply Shape for DCPM Power System" ;
    sh:description "SHACL shape requiring UPS to have battery health, runtime monitoring, and relationships" ;

    # --- Telemetry  ---
    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class dcpm:SoC ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:PERCENT ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "State of Charge Point" ;
        sh:description "UPS must monitor battery state of charge (%)"
    ] ;
    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class dcpm:SoH ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:PERCENT ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "State of Health Point" ;
        sh:description "UPS must monitor battery state of health (%)"
    ] ;
    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class dcpm:RemainingTime ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:MIN ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Remaining Backup Time Point" ;
        sh:description "UPS must provide remaining runtime estimation (min)"
    ] ;

    # --- Telemetry [S] : simple_dc:ups-1 ---
    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class dcpm:ImportActivePower ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Input Active Power Point" ;
        sh:description "UPS must monitor input active power (kW)"
    ] ;
    sh:property [
        sh:path dcpm:hasTelemetryPoint ;
        sh:qualifiedValueShape [
            sh:class dcpm:ExportActivePower ;
            sh:property [
                sh:path [ sh:alternativePath ( brick:hasUnit qudt:hasUnit ) ] ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:name "Output Active Power Point" ;
        sh:description "UPS must monitor output active power (kW)"
    ] ;

    # --- Relationships ---
    sh:property [
        sh:path dcpm:feeds ;
        sh:minCount 1 ;
        sh:or (
            [ sh:class dcpm:PDUType ]
            [ sh:class dcpm:BuswayType ]
            [ sh:class dcpm:STSType ]
        ) ;
        sh:name "feeds target" ;
    ] ;
    sh:property [
        sh:path dcpm:fedBy ;
        sh:or (
            [ sh:class dcpm:SwitchgearType ]
            [ sh:class dcpm:ATSType ]
            [ sh:class dcpm:TransformerType ]
        ) ;
        sh:name "fedBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:suppliesPowerTo ;
        sh:or (
            [ sh:class dcpm:PDUType ]
            [ sh:class dcpm:BuswayType ]
            [ sh:class dcpm:STSType ]
        ) ;
        sh:name "suppliesPowerTo target" ;
    ] ;
    sh:property [
        sh:path dcpm:suppliedBy ;
        sh:or (
            [ sh:class dcpm:SwitchgearType ]
            [ sh:class dcpm:ATSType ]
            [ sh:class dcpm:TransformerType ]
        ) ;
        sh:name "suppliedBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:primarySource ;
        sh:or (
            [ sh:class dcpm:SwitchgearType ]
            [ sh:class dcpm:ATSType ]
        ) ;
        sh:name "primarySource" ;
    ] ;
    sh:property [
        sh:path dcpm:backupSource ;
        sh:or (
            [ sh:class dcpm:SwitchgearType ]
            [ sh:class dcpm:ATSType ]
        ) ;
        sh:name "backupSource" ;
    ] ;
    sh:property [
        sh:path dcpm:protects ;
        sh:or (
            [ sh:class dcpm:PDUType ]
            [ sh:class dcpm:BuswayType ]
        ) ;
        sh:name "protects target" ;
    ] ;
    sh:property [
        sh:path dcpm:protectedBy ;
        sh:or (
            [ sh:class dcpm:SwitchgearType ]
            [ sh:class dcpm:SPDType ]
        ) ;
        sh:name "protectedBy source" ;
    ] ;
    sh:property [
        sh:path dcpm:connectedTo ;
        sh:or (
            [ sh:class dcpm:BMSType ]
            [ sh:class dcpm:GatewayType ]
            [ sh:class dcpm:ControllerType ]
            [ sh:class dcpm:PQMeterType ]
        ) ;
        sh:name "connectedTo target" ;
    ] ;
    sh:property [
        sh:path dcpm:controlledBy ;
