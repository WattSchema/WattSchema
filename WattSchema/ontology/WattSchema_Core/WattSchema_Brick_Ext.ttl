@prefix wsch_brick: <http://qcells.io/ontologies/DCPM_Brick_Extension#> .
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix bsh: <https://brickschema.org/schema/BrickShape#> .
@prefix rec: <https://brickschema.org/schema/Brick/extension/rec#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix qudtqk: <http://qudt.org/vocab/quantitykind/> .


# cheating and just copying this over to avoid having to pull all of brick in here for now
# this is a clever hack in brick to avoid having to list out all of the numeric types when constraining a value to a number with sh:or
bsh:NumericValue a rdf:List ;
    rdf:first [ sh:datatype xsd:float ] ;
    rdf:rest ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] [ sh:datatype xsd:double ] ) .

# IT Infrastructure Classes

wsch_brick:Hot_Aisle a owl:Class ;
    rdfs:subClassOf rec:HVACZone,
        s223:PhysicalSpace ;
    rdfs:label "Hot Aisle" ;
    rdfs:comment "An aisle in a data center where hot air is circulated" .

wsch_brick:Cold_Aisle a owl:Class ;
    rdfs:subClassOf rec:HVACZone,
        s223:PhysicalSpace ;
    rdfs:label "Cold Aisle" ;
    rdfs:comment "An aisle in a data center where cold air is circulated" .

# System Classes

wsch_brick:Chiller_Plant a owl:Class ;
    rdfs:subClassOf brick:System ;
    rdfs:label "Chiller Plant" ;
    rdfs:comment "A chiller plant system consisting of chillers, headers, and associated equipment" .

wsch_brick:Chiller_Plant_Header a owl:Class ;
    rdfs:subClassOf s223:Junction ;
    rdfs:label "Chiller Plant Header" ;
    rdfs:comment "A header (junction) in the chiller plant that distributes chilled or condenser water" .

wsch_brick:Air_Header a owl:Class ;
    rdfs:subClassOf s223:Junction ;
    rdfs:label "Air Header" ;
    rdfs:comment "A header (junction) that mediates air distribution between air-handling equipment (e.g., AHU, CRAH) and conditioned spaces (e.g., Cold Aisle, Hot Aisle). Because equipment fans are not dedicated to a single aisle, equipment and spaces share a common air path in an N:M relationship; the Air_Header represents that shared junction, decoupling the direct N:M feeds/isFedBy relationships into N:1 + 1:M through the junction." .

# Equipment Classes

wsch_brick:Air_Dirt_Separator a owl:Class ;
    rdfs:subClassOf brick:HVAC_Equipment ;
    rdfs:label "Air Dirt Separator" ;
    rdfs:comment "A piece of HVAC equipment that removes entrained air and suspended particulates from chilled, hot, or condenser water in a hydronic loop" .

wsch_brick:Coolant_Distribution_Unit a owl:Class ;
    rdfs:subClassOf brick:HVAC_Equipment ;
    rdfs:label "Coolant Distribution Unit" ;
    rdfs:comment "An HVAC equipment that delivers controlled-temperature coolant from a secondary technology loop to IT rack cold plates and other direct liquid cooling components, exchanging heat with the facility's primary chilled water loop" .

wsch_brick:Evaporator a owl:Class ;
    rdfs:subClassOf brick:Heat_Exchanger ;
    rdfs:label "Evaporator" ;
    rdfs:comment "A heat exchanger in which the refrigerant absorbs heat from the medium being cooled (e.g., chilled water or air) and evaporates. In a chiller, it cools the chilled water loop" .

# New sensor classes
wsch_brick:Condenser_Water_Approach_Temperature_Sensor a owl:Class;
    rdfs:label "Condenser Water Approach Temperature Sensor"@en ;
    rdfs:subClassOf brick:Condenser_Water_Temperature_Sensor,
        brick:Differential_Temperature_Sensor ;
    skos:definition "Measures the difference between the leaving condenser water temperature and the outside air wet-bulb temperature, commonly referred to as cooling tower approach temperature."@en ;
    brick:hasQuantity brick:Differential_Temperature ;
    brick:hasSubstance brick:Condenser_Water .

wsch_brick:Cooling_Thermal_Power_Sensor a owl:Class;
    rdfs:label "Cooling Thermal Power Sensor"@en ;
    rdfs:subClassOf brick:Thermal_Power_Sensor ;
    skos:definition "Measures the rate of thermal energy removal by a cooling process, typically expressed in units of power (e.g., kW, tons, Btu/h)."@en ;
    brick:hasQuantity qudtqk:Power .

# these are pretty rare since COP is usually calculated, but you can in theory expose it as a point and we have seen it used, so add it in our extension
wsch_brick:Coefficient_Of_Performance_Sensor a owl:Class ;
    rdfs:label "Coefficient of Performance Sensor"@en ;
    rdfs:subClassOf brick:Sensor ;
    skos:definition "Measures the coefficient of performance (COP) of a system, defined as the ratio of useful thermal energy transfer to the required input energy."@en ;
    brick:hasQuantity qudtqk:CoefficientOfPerformance .

# Properties

wsch_brick:maxLoad a owl:DatatypeProperty ;
    rdfs:label "Maximum Load" ;
    rdfs:comment "Maximum power consumption of the equipment under full load" ;
    rdfs:range xsd:decimal .

wsch_brick:ratedAirFlowCapacity a owl:DatatypeProperty ;
    rdfs:label "Rated Air Flow Parameter"@en ;
    skos:definition "The rated air flow for an AHU, used for calculating the maximum supply air flow setpoint limit"@en .

wsch_brick:ratedWaterFlowCapacity a owl:DatatypeProperty ;
    rdfs:label "Rated Water Flow Parameter"@en ;
    skos:definition "The rated water flow for a piece of equipment, used for calculating the maximum water flow setpoint limit"@en .

wsch_brick:ratedHead a owl:DatatypeProperty ;
    rdfs:label "Rated Head (total dynamic head)"@en ;
    skos:definition "The rated/design total dynamic head a pump or other hydraulic equipment is sized for, expressed as head of water (e.g. ft H2O). Used for pump staging and flow balancing in a chilled-water loop. Excludes NPSH."@en .

wsch_brick:minimumFlowFraction a owl:DatatypeProperty ;
    rdfs:label "Minimum Flow Fraction Parameter"@en ;
    skos:definition "The minimum flow fraction for a piece of equipment, used for calculating the minimum water or air flow setpoint limit as a fraction of the rated flow capacity. A number between 0 and 1"@en ;
    rdfs:range xsd:decimal .

wsch_brick:minimumPartLoadRatio a owl:DatatypeProperty ;
    rdfs:label "Minimum Chiller Part Load Ratio Parameter"@en ;
    skos:definition "The minimum part load ratio for a chiller, used for calculating the minimum water flow setpoint limit as a fraction of the rated flow capacity. A number between 0 and 1"@en ;
    rdfs:range xsd:decimal .

wsch_brick:maximumPartLoadRatio a owl:DatatypeProperty ;
    rdfs:label "Maximum Chiller Part Load Ratio Parameter"@en ;
    skos:definition "The maximum part load ratio for a chiller, used for calculating the maximum water flow setpoint limit as a fraction of the rated flow capacity. A number between 0 and 1"@en ;
    rdfs:range xsd:decimal .

wsch_brick:ratedPressureDrop a owl:DatatypeProperty ;
    rdfs:label "Rated Pressure Drop"@en ;
    skos:definition "The rated/design pressure drop across a piece of equipment (e.g. a coil, filter, strainer, or heat exchanger) at rated flow, expressed as a pressure quantity (e.g. Pa, kPa, psi, ft H2O, m H2O). Used by the optimizer for staging and fouling/part-load diagnostics."@en .

wsch_brick:shutoffHeadFactor a owl:DatatypeProperty ;
    rdfs:label "Shutoff Head Factor Parameter"@en ;
    skos:definition "The ratio of a pump's shutoff head (total dynamic head at zero flow) to its rated head, used by the optimizer to approximate the pump curve for staging and minimum-flow calculations. A dimensionless number, typically greater than 1"@en ;
    rdfs:range xsd:decimal .

wsch_brick:aggregatesClass a owl:ObjectProperty ;
    rdfs:label "Aggregates Class" ;
    rdfs:comment "The class that all member points of an aggregate must instantiate" ;
    rdfs:domain wsch_brick:AggregatePoint .

wsch_brick:aggregationSemantics a owl:DatatypeProperty ;
    rdfs:label "Aggregation Semantics" ;
    rdfs:comment "Describes the type of aggregation: 'snapshot' for instantaneous spatial aggregation across multiple sensors" ;
    rdfs:range rdfs:Literal .

# Aggregate Point Class

wsch_brick:AggregatePoint a owl:Class ;
    rdfs:subClassOf brick:Point ;
    rdfs:label "Aggregate Point" ;
    rdfs:comment "A virtual sensor point that aggregates values from multiple physical sensors at the same point in time (spatial aggregation)" .

# Point parameters
# Note that Brick has some parameter/limit classes and defines them as subclasses of point, but hasPoint is only supposed to apply to equipment or spaces
# so we're going to add a new relationship, hasParameter, to link points to their parameters (which are also points, though I hope that Brick revisits that) 

wsch_brick:hasParameter a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty,
        brick:Relationship ;
    rdfs:label "Has parameter"@en ;
    owl:inverseOf brick:isParameterOf ;
    skos:definition "The subject is a source of telemetry, and the object is a parameter of that source, for example, the minimum allowable value of a setpoint. For now, this only applies to points. In some systems the source of telemetry may be represented as a digital/analog input/output point"@en .

wsch_brick:isParameterOf a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty,
        brick:Relationship ;
    rdfs:label "Is parameter of"@en ;
    owl:inverseOf wsch_brick:hasParameter ;
    skos:definition "The subject is a parameter of the object, and the object is a source of telemetry. For example, the minimum allowable value of a setpoint. For now, this only applies to points. In some systems the source of telemetry may be represented as a digital/analog input/output point"@en .

# New parameter classes
wsch_brick:Max_Supply_Water_Temperature_Ramp_Rate a owl:Class ;
    rdfs:subClassOf brick:Parameter ;
    rdfs:label "Supply Water Temperature Ramp Rate" ;
    rdfs:comment "The maximum allowable rate of change for the supply water temperature setpoint" .

wsch_brick:Min_Water_Flow_Setpoint_Limit a owl:Class;
    rdfs:label "Min Water Flow Setpoint Limit"@en ;
    rdfs:subClassOf brick:Limit,
        brick:Min_Limit ;
    skos:definition "A parameter that places a lower bound on the range of permitted values of a Water_Flow_Setpoint."@en .

wsch_brick:Max_Water_Flow_Setpoint_Limit a owl:Class;
    rdfs:label "Max Water Flow Setpoint Limit"@en ;
    rdfs:subClassOf brick:Limit,
        brick:Max_Limit ;
    skos:definition "A parameter that places an upper bound on the range of permitted values of a Water_Flow_Setpoint."@en .

wsch_brick:Min_Leaving_Chilled_Water_Temperature_Setpoint_Limit a owl:Class;
    rdfs:label "Min Leaving Chilled Water Temperature Setpoint Limit"@en ;
    rdfs:subClassOf brick:Limit,
        brick:Min_Limit ;
    skos:definition "A parameter that places a lower bound on the range of permitted values of a Leaving_Chilled_Water_Temperature_Setpoint, expressed as a temperature quantity (e.g. DEG_C, DEG_F, K)."@en .

wsch_brick:Max_Leaving_Chilled_Water_Temperature_Setpoint_Limit a owl:Class;
    rdfs:label "Max Leaving Chilled Water Temperature Setpoint Limit"@en ;
    rdfs:subClassOf brick:Limit,
        brick:Max_Limit ;
    skos:definition "A parameter that places an upper bound on the range of permitted values of a Leaving_Chilled_Water_Temperature_Setpoint, expressed as a temperature quantity (e.g. DEG_C, DEG_F, K)."@en .

wsch_brick:Min_Water_Approach_Temperature_Limit a owl:Class;
    rdfs:label "Min Water Approach Temperature Limit"@en ;
    rdfs:subClassOf brick:Limit,
        brick:Min_Limit ;
    skos:definition "A parameter that places a lower bound on the approach temperature of water-based heat exchangers. (condenser water supply temperature must be at least outdoor wet-bulb plus this value). Typically small (5-7 degrees F)" .

wsch_brick:Max_Supply_Air_Temperature_Ramp_Rate a owl:Class ;
    rdfs:subClassOf brick:Parameter ;
    rdfs:label "Supply Air Temperature Ramp Rate" ;
    rdfs:comment "The maximum allowable rate of change for the supply air temperature setpoint" .

wsch_brick:Min_Temperature_Operational_Limit a owl:Class ;
    rdfs:label "Min Temperature Operational Limit"@en ;
    rdfs:subClassOf brick:Min_Limit,
        brick:Temperature_Parameter ;
    rdfs:comment "A parameter that places a lower bound on the range of permitted values of observed temperature" .

wsch_brick:Max_Temperature_Operational_Limit a owl:Class;
    rdfs:label "Max Temperature Operational Limit"@en ;
    rdfs:subClassOf brick:Max_Limit,
        brick:Temperature_Parameter ;
    rdfs:comment "A parameter that places an upper bound on the range of permitted values of observed temperature. This maybe should be a brick:alarm." .

wsch_brick:Min_Temperature_Difference_Operational_Limit a owl:Class ;
    rdfs:label "Min Temperature Difference Operational Limit"@en ;
    rdfs:subClassOf brick:Min_Limit ;
    rdfs:comment "A parameter that places a lower bound on the range of permitted values of an observed temperature difference (e.g., entering minus leaving water temperature)." .

wsch_brick:Max_Temperature_Difference_Operational_Limit a owl:Class;
    rdfs:label "Max Temperature Difference Operational Limit"@en ;
    rdfs:subClassOf brick:Max_Limit ;
    rdfs:comment "A parameter that places an upper bound on the range of permitted values of an observed temperature difference (e.g., entering minus leaving water temperature)." .


# SHACL Shapes - only for items defined in this extension. The site-specific rules (e.g. chillers must have the at least this set of points) is in the shacl_profiles/ directory

wsch_brick:AggregatePointShape a sh:NodeShape ;
    sh:targetClass wsch_brick:AggregatePoint ;
    sh:name "Aggregate Point Shape for DCPM" ;
    sh:description "SHACL shape defining required properties and constraints for aggregate points" ;
    
    # Required: aggregatesClass property
    sh:property [
        sh:path wsch_brick:aggregatesClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "Aggregates Class" ;
        sh:description "Must specify exactly one class that all aggregated members instantiate"
    ] ;
    
    # Required: aggregationSemantics property (with value "snapshot")
    sh:property [
        sh:path wsch_brick:aggregationSemantics ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "snapshot" ;
        sh:name "Aggregation Semantics" ;
        sh:description "Must be 'snapshot' for spatial aggregation"
    ] ;
    
    # Required: brick:aggregate with aggregationFunction
    sh:property [
        sh:path brick:aggregate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNode ;
        sh:name "Aggregate Metadata" ;
        sh:description "Must have exactly one brick:aggregate entity with aggregationFunction"
    ] ;
    
    # Required: at least one brick:hasPart member
    sh:property [
        sh:path brick:hasPart ;
        sh:minCount 1 ;
        sh:name "Aggregated Members" ;
        sh:description "Must have at least one member point that is aggregated"
    ] ;
    
    # Constraint: All brick:hasPart members must be instances of aggregatesClass
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "All members referenced by brick:hasPart must be instances of the aggregatesClass" ;
        sh:prefixes wsch_brick: ;
        sh:prefixes brick: ;
        sh:select """
            SELECT $this
            WHERE {
                $this wsch_brick:aggregatesClass ?class .
                $this brick:hasPart ?member .
                FILTER NOT EXISTS { ?member a ?class }
            }
        """
    ] .


wsch_brick:Water_Flow_CapacityQuantityShape a owl:Class,
        sh:NodeShape,
        brick:EntityPropertyValue ;
    rdfs:subClassOf bsh:ValueShape ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or bsh:NumericValue ;
            sh:path brick:value ],
        [ a sh:PropertyShape ;
            sh:in ( unit:KiloGM-PER-SEC unit:GAL_US-PER-MIN ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path brick:hasUnit ] .

wsch_brick:Air_Flow_CapacityQuantityShape a owl:Class,
        sh:NodeShape,
        brick:EntityPropertyValue ;
    rdfs:subClassOf bsh:ValueShape ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or bsh:NumericValue ;
            sh:path brick:value ],
        [ a sh:PropertyShape ;
            sh:in ( unit:KiloGM-PER-SEC unit:FT3-PER-MIN ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path brick:hasUnit ] .

wsch_brick:Pressure_Drop_CapacityQuantityShape a owl:Class,
        sh:NodeShape,
        brick:EntityPropertyValue ;
    rdfs:subClassOf bsh:ValueShape ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or bsh:NumericValue ;
            sh:path brick:value ],
        [ a sh:PropertyShape ;
            sh:in ( unit:PA unit:KiloPA unit:PSI unit:FT_H2O unit:M_H2O ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path brick:hasUnit ] .