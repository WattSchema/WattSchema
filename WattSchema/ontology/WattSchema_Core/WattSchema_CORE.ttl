# ========================================
# Rated Properties for PowerDeviceType
# ========================================
wattsch:ratedPower a owl:ObjectProperty ;
    rdfs:domain wattsch:PowerDeviceType ;
    rdfs:range wattsch:ActivePower ;
    rdfs:label "Rated Active Power" ;
    rdfs:comment "Nominal rated active power capacity of the device." .

wattsch:ratedVoltage a owl:ObjectProperty ;
    rdfs:domain wattsch:PowerDeviceType ;
    rdfs:range wattsch:Voltage ;
    rdfs:label "Rated Voltage" ;
    rdfs:comment "Nominal rated operating voltage of the device." .

wattsch:ratedCurrent a owl:ObjectProperty ;
    rdfs:domain wattsch:PowerDeviceType ;
    rdfs:range wattsch:Current ;
    rdfs:label "Rated Current" ;
    rdfs:comment "Nominal rated operating current of the device." .

wattsch:ratedStorageCapacity a owl:ObjectProperty ;
    rdfs:domain wattsch:BESSType ;
    rdfs:range wattsch:EnergyAvailable ;
    rdfs:label "Rated Storage Capacity" ;
    rdfs:comment "Nominal energy storage capacity of battery energy storage system." .

# ===========================
# Electrical Context Classes
# ===========================
wattsch:Phase a owl:Class ;
    rdfs:label "Electrical Phase" ;
    rdfs:comment "Represents an electrical phase identifier (e.g., L1, L2, L3, N, LL, LN) for polyphase systems." .

wattsch:Phase_L1 a wattsch:Phase ; rdfs:label "Phase L1" .
wattsch:Phase_L2 a wattsch:Phase ; rdfs:label "Phase L2" .
wattsch:Phase_L3 a wattsch:Phase ; rdfs:label "Phase L3" .
wattsch:Phase_LN a wattsch:Phase ; rdfs:label "Line-to-Neutral" .
wattsch:Phase_LL a wattsch:Phase ; rdfs:label "Line-to-Line" .

# ===========================
# Object Properties 
# ===========================
wattsch:containsEquipment a owl:ObjectProperty ;
  rdfs:label "Contains Equipment" .

wattsch:hasLocation a owl:ObjectProperty ;
  owl:equivalentProperty brick:hasLocation ;
  owl:inverseOf wattsch:isLocationOf ;
  rdfs:label "Has Location" ;
  rdfs:comment "Subject is physically located in the location given by the object" .

wattsch:isLocationOf a owl:ObjectProperty ;
  owl:equivalentProperty brick:isLocationOf ;
  owl:inverseOf wattsch:hasLocation ;
  rdfs:label "Is Location Of" ;
  rdfs:comment "Subject is a physical location that contains the object" .

wattsch:fedBy a owl:ObjectProperty ;
  owl:inverseOf wattsch:feeds ;
  owl:equivalentProperty brick:isFedBy ;
  rdfs:label "Fed By" .

wattsch:feeds a owl:ObjectProperty ;
  owl:inverseOf wattsch:fedBy ;
  owl:equivalentProperty brick:feeds ;
  rdfs:label "Feeds" .

wattsch:suppliedBy a owl:ObjectProperty ;
  owl:inverseOf wattsch:suppliesPowerTo ;
  rdfs:label "Supplied By" .

wattsch:suppliesPowerTo a owl:ObjectProperty ;
  owl:inverseOf wattsch:suppliedBy ;
  rdfs:label "Supplies Power To" .

wattsch:hasTelemetryStream a owl:ObjectProperty ;
  rdfs:label "Has Telemetry Stream" ;
  rdfs:comment "Links a TelemetryStream to its contained TelemetryPoints" .

wattsch:hasTelemetryPoint a owl:ObjectProperty ;
  rdfs:label "Has Telemetry Point" ;
  owl:equivalentProperty brick:hasPoint .

wattsch:isTelemetryStreamOf a owl:ObjectProperty ;
  rdfs:subPropertyOf brick:isPointOf ;
  rdfs:label "Is Telemetry Stream Of" ;
  rdfs:comment "Links a TelemetryStream to the device it belongs to" .

wattsch:isTelemetryOf a owl:ObjectProperty ;
  rdfs:subPropertyOf brick:isPointOf ;
  rdfs:label "Is Telemetry Of" ;
  rdfs:comment "Links a Telemetry to the device or telemetry stream it belongs to" .

wattsch:protects a owl:ObjectProperty ;
  owl:inverseOf wattsch:protectedBy ;
  rdfs:label "Protects" ;
  rdfs:comment "A directed reference pair indicating a protection relationship." .

wattsch:protectedBy a owl:ObjectProperty ;
  owl:inverseOf wattsch:protects ;
  rdfs:label "ProtectedBy" ;
  rdfs:comment "A directed reference pair indicating a protection relationship." .

wattsch:connectedTo a owl:ObjectProperty ;
  rdfs:label "ConnectedTo" ;
  owl:equivalentProperty s223:connectedTo ;
  owl:inverseOf wattsch:connectedFrom ;
  rdfs:comment "A symmetric reference used for general, non-power-flow connections, such as data or communication links between two devices." .

wattsch:connectedFrom a owl:ObjectProperty ;
  rdfs:label "ConnectedFrom" ;
  owl:equivalentProperty s223:connectedFrom ;
  owl:inverseOf wattsch:connectedTo ;
  rdfs:comment "A directed reference pair indicating a connection relationship." .

wattsch:controls a owl:ObjectProperty ;
  owl:inverseOf wattsch:controlledBy ;
  rdfs:label "Controls" ;
  rdfs:comment "A directed reference pair indicating a control relationship." .

wattsch:controlledBy a owl:ObjectProperty ;
  owl:inverseOf wattsch:controls ;
  rdfs:label "ControlledBy" ;
  rdfs:comment "A directed reference pair indicating a control relationship." .

wattsch:hasSOP a owl:ObjectProperty ;
  rdfs:label "Has SOP" ;
  rdfs:comment "Power system or electric equipment associated with Standard Operating Procedures (SOPs)" .

wattsch:hasPhase a owl:ObjectProperty ;
    rdfs:label "Has Phase" ;
    rdfs:comment "Associates a telemetry point or measurement with its electrical phase context." .

wattsch:hasDocument a owl:ObjectProperty ;
  rdfs:label "Has Document" ;
  rdfs:comment "Associates a DeviceType instance with one or more documentation artifacts." .

wattsch:hasPointOfInterconnection a owl:ObjectProperty ;
  rdfs:label "Has Point of Interconnection" ;
  rdfs:domain wattsch:SiteType ;
  rdfs:range wattsch:PointOfInterconnection ;
  rdfs:comment "Associates a SiteType instance with one or more Points of Interconnection (POIs) representing grid connections for settlement, demand, or value stream participation." .

wattsch:hasValueStream a owl:ObjectProperty ;
  rdfs:label "Has Value Stream" ;
  rdfs:comment "Associates a SiteType, PowerDeviceType, or PointOfInterconnection instance with one or more value streams for optimization or program participation." .

wattsch:primarySource a owl:ObjectProperty ;
  rdfs:label "Primary Source" ;
  rdfs:comment "Primary source of power for a device, used for energy." .

wattsch:backupSource a owl:ObjectProperty ;
  rdfs:label "Backup Source" ;
  rdfs:comment "Backup source of power for a device, used for energy." .

# ======================================== 
# Enumeration Type
# ========================================
wattsch:BreakerStateEnum a rdfs:Datatype ;
    rdfs:label "Breaker State Enumeration" ;
    owl:oneOf ( "Unknown" "Open" "Closed" "Tripped" "Intermediate" ) ;
    rdfs:comment "0=Unknown, 1=Open, 2=Closed, 3=Tripped, 4=Intermediate" .

wattsch:DeviceStateEnum a rdfs:Datatype ;
    rdfs:label "Device State Enumeration" ;
    owl:oneOf ( "Unknown" "Stopped" "Standby" "Running" "Faulted" "Maintenance" ) ;
    rdfs:comment "0=Unknown, 1=Stopped, 2=Standby, 3=Running, 4=Faulted, 5=Maintenance" .

wattsch:SourceEnum a rdfs:Datatype ;
    rdfs:label "Source Enumeration" ;
    owl:oneOf ( "Utility" "Generator" "UPS" "BESS" "Bypass" ) ;
    rdfs:comment "0=Utility, 1=Generator, 2=UPS, 3=BESS, 4=Bypass" .

wattsch:UPSModeEnum a rdfs:Datatype ;
    rdfs:label "UPS Mode Enumeration" ;
    owl:oneOf ( "Online" "OnBattery" "Eco" "Bypass" "Standby" "Fault" ) ;
    rdfs:comment "0=Online, 1=OnBattery, 2=Eco, 3=Bypass, 4=Standby, 5=Fault" .

wattsch:ATSModeEnum a rdfs:Datatype ;
    rdfs:label "ATS Mode Enumeration" ;
    owl:oneOf ( "Auto" "Manual" "Test" "LockedOut" ) ;
    rdfs:comment "0=Auto, 1=Manual, 2=Test, 3=LockedOut" .

wattsch:GenModeEnum a rdfs:Datatype ;
    rdfs:label "Generator Mode Enumeration" ;
    owl:oneOf ( "Ready" "Starting" "Running" "Testing" "Cooldown" "Stopped" "Fault" ) ;
    rdfs:comment "0=Ready, 1=Starting, 2=Running, 3=Testing, 4=Cooldown, 5=Stopped, 6=Fault" .

wattsch:BatteryChemistryEnum a rdfs:Datatype ;
    rdfs:label "Battery Chemistry Enumeration" ;
    owl:oneOf ( "LFP" "NMC" "NCA" "LeadAcid" "Other" ) ;
    rdfs:comment "0=LFP (LiFePO4), 1=NMC, 2=NCA, 3=LeadAcid, 4=Other" .

wattsch:ThyristorHealthEnum a rdfs:Datatype ;
    rdfs:label "Thyristor Health Enumeration" ;
    owl:oneOf ( "Good" "Fair" "Poor" ) ;
    rdfs:comment "0=Good, 1=Fair, 2=Poor" .

wattsch:MotorFeederStarterStateEnum a rdfs:Datatype ;
    rdfs:label "Motor Feeder Starter State Enumeration" ;
    owl:oneOf ( "Off" "Run" "Trip" ) ;
    rdfs:comment "0=Off, 1=Run, 2=Trip" .

wattsch:UPSAlarmStatusEnum a rdfs:Datatype ;
    rdfs:label "UPS Alarm Status Enumeration" ;
    owl:oneOf ( "Normal" "Warning" "Alarm" "Critical" ) ;
    rdfs:comment "0=Normal, 1=Warning, 2=Alarm, 3=Critical" .

wattsch:GenAlarmStatusEnum a rdfs:Datatype ;
    rdfs:label "Generator Alarm Status Enumeration" ;
    owl:oneOf ( "Normal" "Warning" "Alarm" "Critical" "Shutdown" ) ;
    rdfs:comment "0=Normal, 1=Warning, 2=Alarm, 3=Critical, 4=Shutdown" .

wattsch:BESSAlarmStatusEnum a rdfs:Datatype ;
    rdfs:label "BESS Alarm Status Enumeration" ;
    owl:oneOf ( "Normal" "Warning" "Alarm" "Critical" "Fault" ) ;
    rdfs:comment "0=Normal, 1=Warning, 2=Alarm, 3=Critical, 4=Fault" .

wattsch:ATSAlarmStatusEnum a rdfs:Datatype ;
    rdfs:label "ATS Alarm Status Enumeration" ;
    owl:oneOf ( "Normal" "Warning" "Alarm" "Critical" ) ;
    rdfs:comment "0=Normal, 1=Warning, 2=Alarm, 3=Critical" .

wattsch:BreakerTripCauseEnum a rdfs:Datatype ;
    rdfs:label "Breaker Trip Cause Enumeration" ;
    owl:oneOf ( "None" "Overload" "ShortCircuit" "GroundFault" "Undervoltage" "Overvoltage" "Manual" "Other" ) ;
    rdfs:comment "0=None, 1=Overload, 2=ShortCircuit, 3=GroundFault, 4=Undervoltage, 5=Overvoltage, 6=Manual, 7=Other" .

wattsch:ValueStreamProgramEnum a rdfs:Datatype ;
    rdfs:label "Value Stream Program Enumeration" ;
    owl:oneOf (
        "Tariff Based Energy Arbitrage"
        "Tariff Based Demand Charge Management"
        "MA Clean Peak"
        "SGIP"
        "ITC"
    ) ;
    rdfs:comment "0=Tariff Based Energy Arbitrage, 1=Tariff Based Demand Charge Management, 2=MA Clean Peak, 3=SGIP, 4=ITC" .

wattsch:BusinessSegmentEnum a rdfs:Datatype ;
    rdfs:label "Business Segment Enumeration" ;
    owl:equivalentClass [
        rdf:type rdfs:Datatype ;
        owl:oneOf ( "Hyperscale" "Colocation" "Enterprise" "Edge" )
    ] ;
    rdfs:comment "0=Hyperscale, 1=Colocation, 2=Enterprise, 3=Edge" .

