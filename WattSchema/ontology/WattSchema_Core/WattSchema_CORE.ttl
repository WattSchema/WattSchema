# ========================================
# DOCUMENT METADATA PROPERTIES
# ========================================

wattsch:documentUrl a owl:DatatypeProperty ;
    rdfs:subPropertyOf wattsch:url ;
    rdfs:label "Document URL" ;
    rdfs:domain wattsch:Document ;
    rdfs:range xsd:anyURI .

wattsch:documentFileName a owl:DatatypeProperty ;
    rdfs:label "Document File Name" ;
    rdfs:domain wattsch:Document ;
    rdfs:range xsd:string .

wattsch:documentVersion a owl:DatatypeProperty ;
    rdfs:label "Document Version" ;
    rdfs:domain wattsch:Document ;
    rdfs:range xsd:string .


# ========================================
# SHACL SHAPES
# ========================================

# 1. Common Device Shape (wattsch:PowerDeviceType)

wattsch:PowerDeviceCommonShape a sh:NodeShape ;
    sh:targetClass wattsch:PowerDeviceType ;
    sh:name "Power Device Common Shape" ;
    # Mandatory Properties
    sh:property [
        sh:path wattsch:manufacturer ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "Manufacturer" ;
        sh:description "Manufacturer of the power device is mandatory."
    ] ;
    sh:property [
        sh:path wattsch:model ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "Model" ;
        sh:description "Model name is mandatory."
    ] ;
    sh:property [
        sh:path wattsch:serialNumber ;
        sh:datatype xsd:string ;
        sh:name "Serial Number" ;
        sh:description "Serial number assigned by the manufacturer (Optional)."
    ] ;
    sh:property [
        sh:path wattsch:assetId ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "Asset ID" ;
        sh:description "Unique internal asset identifier is mandatory."
    ] ;
    # Optional Properties
    sh:property [
        sh:path wattsch:hasSOP ;
        sh:class wattsch:SOP ;
        sh:name "SOP" ;
        sh:description "Standard Operating Procedure documentation (Optional)."
    ] ;
    sh:property [
        sh:path wattsch:hasDocument ;
        sh:class wattsch:Document ;
        sh:name "General Document" ;
        sh:description "Associated technical documentation (Optional)."
    ] .

